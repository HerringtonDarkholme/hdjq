## Port of gojq/lexer.go.
use pkg.goshim.json.unquote
use pkg.gojq.query.{Query, Operator}
use pkg.gojq.error.JqError

pub fn tok_alt_op() -> i64: 57346
pub fn tok_update_op() -> i64: 57347
pub fn tok_compare_op() -> i64: 57348
pub fn tok_or_op() -> i64: 57349
pub fn tok_and_op() -> i64: 57350
pub fn tok_module() -> i64: 57351
pub fn tok_import() -> i64: 57352
pub fn tok_include() -> i64: 57353
pub fn tok_def() -> i64: 57354
pub fn tok_as() -> i64: 57355
pub fn tok_label() -> i64: 57356
pub fn tok_break() -> i64: 57357
pub fn tok_null() -> i64: 57358
pub fn tok_true() -> i64: 57359
pub fn tok_false() -> i64: 57360
pub fn tok_if() -> i64: 57361
pub fn tok_then() -> i64: 57362
pub fn tok_elif() -> i64: 57363
pub fn tok_else() -> i64: 57364
pub fn tok_end() -> i64: 57365
pub fn tok_try() -> i64: 57366
pub fn tok_catch() -> i64: 57367
pub fn tok_reduce() -> i64: 57368
pub fn tok_foreach() -> i64: 57369
pub fn tok_ident() -> i64: 57370
pub fn tok_variable() -> i64: 57371
pub fn tok_module_ident() -> i64: 57372
pub fn tok_module_variable() -> i64: 57373
pub fn tok_recurse() -> i64: 57374
pub fn tok_index() -> i64: 57375
pub fn tok_number() -> i64: 57376
pub fn tok_format() -> i64: 57377
pub fn tok_string() -> i64: 57378
pub fn tok_string_start() -> i64: 57379
pub fn tok_string_query() -> i64: 57380
pub fn tok_string_end() -> i64: 57381
pub fn tok_invalid() -> i64: 57382
pub fn tok_invalid_escape_sequence() -> i64: 57383
pub fn tok_unterminated_string() -> i64: 57384

EOF_TOK := -1i64

fn keyword(s: string) -> i64?:
    match s:
        "or" => .Some(tok_or_op())
        "and" => .Some(tok_and_op())
        "module" => .Some(tok_module())
        "import" => .Some(tok_import())
        "include" => .Some(tok_include())
        "def" => .Some(tok_def())
        "as" => .Some(tok_as())
        "label" => .Some(tok_label())
        "break" => .Some(tok_break())
        "null" => .Some(tok_null())
        "true" => .Some(tok_true())
        "false" => .Some(tok_false())
        "if" => .Some(tok_if())
        "then" => .Some(tok_then())
        "elif" => .Some(tok_elif())
        "else" => .Some(tok_else())
        "end" => .Some(tok_end())
        "try" => .Some(tok_try())
        "catch" => .Some(tok_catch())
        "reduce" => .Some(tok_reduce())
        "foreach" => .Some(tok_foreach())
        _ => .None

## What Lex sets in yySymType besides the token type.
pub struct LexVal:
    pub token: string = ""
    pub operator: Operator = .OpNone

pub struct Lexer:
    pub source: string
    src: List[u8]
    pub offset: usize = 0
    pub result: (*mut Query)? = .None
    pub token: string = ""
    pub token_type: i64 = 0
    in_string: bool = false
    pub err: JqError? = .None

pub fn new_lexer(src: string) -> *mut Lexer:
    box(Lexer { source: src, src: src.bytes().collect() })

NUMBER_STATE_LEAD := 0i64
NUMBER_STATE_FLOAT := 1i64
NUMBER_STATE_EXP_LEAD := 2i64
NUMBER_STATE_EXP := 3i64

impl Lexer:
    ## Lex returns the next token type and fills `lval`.
    pub fn lex(&mut self, lval: &mut LexVal) -> i64:
        t := self.lex_inner(lval)
        self.token_type = t
        t

    fn lex_inner(&mut self, lval: &mut LexVal) -> i64:
        if self.src.len() == self.offset:
            self.token = ""
            return EOF_TOK
        if self.in_string:
            let (tok, s) = self.scan_string(self.offset)
            lval.token = s
            return tok
        let .Some(ch) = self.next() else:
            self.token = ""
            return EOF_TOK
        if is_ident(ch, false):
            i := self.offset - 1
            let (j, is_module) = self.scan_ident_or_module()
            self.token = self.source.slice(i, j)
            lval.token = self.token
            if is_module:
                return tok_module_ident()
            match keyword(self.token):
                .Some(t) => return t
                .None => return tok_ident()
        if is_number(ch):
            i := self.offset - 1
            j := self.scan_number(NUMBER_STATE_LEAD)
            if j < 0:
                self.token = self.source.slice(i, usize(-j))
                return tok_invalid()
            self.token = self.source.slice(i, usize(j))
            lval.token = self.token
            return tok_number()
        match ch:
            46 =>
                ch2 := self.peek()
                if ch2 == 46:
                    self.offset += 1
                    self.token = ".."
                    return tok_recurse()
                if is_ident(ch2, false):
                    self.token = self.source.slice(self.offset - 1, self.scan_ident())
                    lval.token = self.token.slice(1, self.token.len())
                    return tok_index()
                if is_number(ch2):
                    i := self.offset - 1
                    j := self.scan_number(NUMBER_STATE_FLOAT)
                    if j < 0:
                        self.token = self.source.slice(i, usize(-j))
                        return tok_invalid()
                    self.token = self.source.slice(i, usize(j))
                    lval.token = self.token
                    return tok_number()
                return 46
            36 =>
                if is_ident(self.peek(), false):
                    i := self.offset - 1
                    let (j, is_module) = self.scan_ident_or_module()
                    self.token = self.source.slice(i, j)
                    lval.token = self.token
                    if is_module:
                        return tok_module_variable()
                    return tok_variable()
            124 =>
                if self.peek() == 61:
                    self.offset += 1
                    self.token = "|="
                    lval.operator = .OpModify
                    return tok_update_op()
            43 =>
                if self.peek() == 61:
                    self.offset += 1
                    self.token = "+="
                    lval.operator = .OpUpdateAdd
                    return tok_update_op()
            45 =>
                if self.peek() == 61:
                    self.offset += 1
                    self.token = "-="
                    lval.operator = .OpUpdateSub
                    return tok_update_op()
            42 =>
                if self.peek() == 61:
                    self.offset += 1
                    self.token = "*="
                    lval.operator = .OpUpdateMul
                    return tok_update_op()
            47 =>
                p := self.peek()
                if p == 61:
                    self.offset += 1
                    self.token = "/="
                    lval.operator = .OpUpdateDiv
                    return tok_update_op()
                if p == 47:
                    self.offset += 1
                    if self.peek() == 61:
                        self.offset += 1
                        self.token = "//="
                        lval.operator = .OpUpdateAlt
                        return tok_update_op()
                    self.token = "//"
                    lval.operator = .OpAlt
                    return tok_alt_op()
            37 =>
                if self.peek() == 61:
                    self.offset += 1
                    self.token = "%="
                    lval.operator = .OpUpdateMod
                    return tok_update_op()
            61 =>
                if self.peek() == 61:
                    self.offset += 1
                    self.token = "=="
                    lval.operator = .OpEq
                    return tok_compare_op()
                self.token = "="
                lval.operator = .OpAssign
                return tok_update_op()
            33 =>
                if self.peek() == 61:
                    self.offset += 1
                    self.token = "!="
                    lval.operator = .OpNe
                    return tok_compare_op()
            62 =>
                if self.peek() == 61:
                    self.offset += 1
                    self.token = ">="
                    lval.operator = .OpGe
                    return tok_compare_op()
                self.token = ">"
                lval.operator = .OpGt
                return tok_compare_op()
            60 =>
                if self.peek() == 61:
                    self.offset += 1
                    self.token = "<="
                    lval.operator = .OpLe
                    return tok_compare_op()
                self.token = "<"
                lval.operator = .OpLt
                return tok_compare_op()
            64 =>
                if is_ident(self.peek(), true):
                    self.token = self.source.slice(self.offset - 1, self.scan_ident())
                    lval.token = self.token
                    return tok_format()
            34 =>
                let (tok, s) = self.scan_string(self.offset - 1)
                lval.token = s
                return tok
            _ =>
                if ch >= 128:
                    # one multibyte rune as the token
                    let end = self.offset
                    while end < self.src.len() && (self.src[end] & 0xC0) == 0x80:
                        end += 1
                    self.token = self.source.slice(self.offset - 1, end)
                    self.offset = end
        i64(ch)

    fn next(&mut self) -> u8?:
        while true:
            ch := self.src[self.offset]
            self.offset += 1
            if ch == 35:
                if self.skip_comment():
                    return .None
            else if !is_white(ch):
                return .Some(ch)
            else if self.src.len() == self.offset:
                return .None
        .None

    fn skip_comment(&mut self) -> bool:
        while true:
            p := self.peek()
            if p == 0:
                return true
            if p == 92:
                self.offset += 1
                q := self.peek()
                if q == 92 || q == 10:
                    self.offset += 1
                else if q == 13:
                    self.offset += 1
                    if self.peek() == 10:
                        self.offset += 1
            else if p == 10 || p == 13:
                return false
            else:
                self.offset += 1
        false

    fn peek(&self) -> u8:
        if self.src.len() == self.offset:
            return 0
        self.src[self.offset]

    fn scan_ident(&mut self) -> usize:
        while is_ident(self.peek(), true):
            self.offset += 1
        self.offset

    fn scan_ident_or_module(&mut self) -> (usize, bool):
        let index = self.scan_ident()
        let is_module = false
        if self.peek() == 58:
            self.offset += 1
            if self.peek() == 58:
                self.offset += 1
                if is_ident(self.peek(), false):
                    self.offset += 1
                    index = self.scan_ident()
                    is_module = true
                else:
                    self.offset -= 2
            else:
                self.offset -= 1
        (index, is_module)

    pub fn valid_var_name(&mut self) -> bool:
        if self.peek() != 36:
            return false
        self.offset += 1
        is_ident(self.peek(), false) && self.scan_ident() == self.src.len()

    ## The end offset of a number; negative (-end) for an invalid token.
    fn scan_number(&mut self, state0: i64) -> i64:
        let state = state0
        while true:
            if state == NUMBER_STATE_LEAD || state == NUMBER_STATE_FLOAT:
                ch := self.peek()
                if is_number(ch):
                    self.offset += 1
                else if ch == 46:
                    if state != NUMBER_STATE_LEAD:
                        self.offset += 1
                        return -i64(self.offset)
                    self.offset += 1
                    state = NUMBER_STATE_FLOAT
                else if ch == 101 || ch == 69:
                    self.offset += 1
                    q := self.peek()
                    if q == 45 || q == 43:
                        self.offset += 1
                    state = NUMBER_STATE_EXP_LEAD
                else:
                    if is_ident(ch, false):
                        self.offset += 1
                        return -i64(self.offset)
                    return i64(self.offset)
            else:
                ch := self.peek()
                if !is_number(ch):
                    if is_ident(ch, false):
                        self.offset += 1
                        return -i64(self.offset)
                    if state == NUMBER_STATE_EXP_LEAD:
                        return -i64(self.offset)
                    return i64(self.offset)
                self.offset += 1
                state = NUMBER_STATE_EXP
        0

    pub fn valid_number(&mut self) -> bool:
        let ch = self.peek()
        if ch == 43 || ch == 45:
            self.offset += 1
            ch = self.peek()
        let state = NUMBER_STATE_LEAD
        if ch == 46:
            self.offset += 1
            ch = self.peek()
            state = NUMBER_STATE_FLOAT
        is_number(ch) && self.scan_number(state) == i64(self.src.len())

    fn unquote_str(&self, src: string, quote: bool, decode: bool) -> string?:
        if !decode:
            if quote:
                return .Some(src)
            return .Some(src.slice(1, src.len() - 1))
        let text = if quote: "\"" + escape_controls(src) + "\"" else: escape_controls(src)
        unquote(text).ok()

    fn scan_string(&mut self, start: usize) -> (i64, string):
        let decode = false
        let i = self.offset
        while i < self.src.len():
            ch := self.src[i]
            if ch == 92:
                i += 1
                if i >= self.src.len():
                    break
                e := self.src[i]
                if e == 117:
                    for j in 1..5:
                        if i + j >= self.src.len() || !is_hex(self.src[i + j]):
                            self.offset = i + j
                            self.token = self.source.slice(i - 1, self.offset)
                            return (tok_invalid_escape_sequence(), "")
                    i += 4
                    decode = true
                else if e == 34 || e == 47 || e == 92 || e == 98 || e == 102 || e == 110 || e == 114 || e == 116:
                    decode = true
                else if e == 40:
                    if !self.in_string:
                        self.in_string = true
                        return (tok_string_start(), "")
                    if i == self.offset + 1:
                        self.offset += 2
                        self.in_string = false
                        return (tok_string_query(), "")
                    self.offset = i - 1
                    self.token = self.source.slice(start, self.offset)
                    match self.unquote_str(self.token, true, decode):
                        .Some(s) => return (tok_string(), s)
                        .None => return (tok_invalid(), "")
                else:
                    self.offset = i + 1
                    self.token = self.source.slice(self.offset - 2, self.offset)
                    return (tok_invalid_escape_sequence(), "")
            else if ch == 34:
                if !self.in_string:
                    self.offset = i + 1
                    self.token = self.source.slice(start, self.offset)
                    match self.unquote_str(self.token, false, decode):
                        .Some(s) => return (tok_string(), s)
                        .None => return (tok_invalid(), "")
                if i > self.offset:
                    self.offset = i
                    self.token = self.source.slice(start, self.offset)
                    match self.unquote_str(self.token, true, decode):
                        .Some(s) => return (tok_string(), s)
                        .None => return (tok_invalid(), "")
                self.in_string = false
                self.offset = i + 1
                return (tok_string_end(), "")
            else:
                if !decode:
                    decode = ch > 126
                if ch < 32:
                    decode = true
            i += 1
        self.offset = self.src.len()
        self.token = ""
        (tok_unterminated_string(), "")

    pub fn set_in_string(&mut self) -> void:
        self.in_string = true

    ## yyLexer.Error: records the ParseError at the current token.
    pub fn error(&mut self) -> void:
        let token = self.token
        if self.token_type != EOF_TOK && self.token_type < 128 && self.token_type >= 0:
            token = string::from_utf8([u8(self.token_type)]).unwrap_or("")
        self.err = .Some(.Parse(i64(self.offset), token, self.token_type))

## quoteAndEscape: control characters become \u00XX so json.Unmarshal accepts them.
fn escape_controls(src: string) -> string:
    hex := "0123456789abcdef"
    let out = ""
    let start = 0
    let bs: List[u8] = src.bytes().collect()
    for i in 0..bs.len():
        ch := bs[i]
        if ch < 32:
            out = out + src.slice(start, i) + "\\u00" + hex.slice(usize(ch >> 4), usize(ch >> 4) + 1) + hex.slice(usize(ch & 15), usize(ch & 15) + 1)
            start = i + 1
    out + src.slice(start, bs.len())

pub fn is_white(ch: u8) -> bool:
    ch == 9 || ch == 10 || ch == 13 || ch == 32

pub fn is_ident(ch: u8, tail: bool) -> bool:
    (ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || ch == 95 || (tail && is_number(ch))

fn is_hex(ch: u8) -> bool:
    (ch >= 97 && ch <= 102) || (ch >= 65 && ch <= 70) || is_number(ch)

fn is_number(ch: u8) -> bool:
    ch >= 48 && ch <= 57
