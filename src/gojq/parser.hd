            v.value = .ConstObjectKeyVals(kvs)
        130 => v.value = .ConstObjectKeyVal(box(ConstObjectKeyVal { key: dollar(s, p, 3, 1).token, val: const_term(dollar(s, p, 3, 3)) }))
