ARGCOUNT0 := 1i64
ARGCOUNT1 := 2i64
ARGCOUNT2 := 4i64
ARGCOUNT3 := 8i64

pub struct Function:
    pub argcount: i64
    pub iter: bool
    pub callback: Callback

impl Function:
    pub fn accept(&self, cnt: i64) -> bool:
        (self.argcount & (1i64 << u32(cnt))) != 0

fn fun(argcount: i64, callback: Callback) -> Function:
    Function { argcount: argcount, iter: false, callback: callback }

fn nil0() -> Function:
    fun(ARGCOUNT0, .Nil)

fn nil1() -> Function:
    fun(ARGCOUNT1, .Nil)

fn local(argcount: i64, name: string) -> Function:
    fun(argcount, .Local(name))

