## Port of gojq/env.go and gojq/execute.go: the backtracking VM.
use pkg.goshim.value.{Value, ArrBox, ObjBox, Allocator, obj, arr, same, is_falsy}
use pkg.gojq.code.{Code, Opcode, Operand, Callback}
use pkg.gojq.stack.Stack
use pkg.gojq.iter.{Item, Iter, PathValue, item_value}
use pkg.gojq.error.{JqError, value_of, error_string}
use pkg.gojq.func.func_index2
use std.console.ConsoleInput
use std.fs.{FsRead, FsWrite}
use std.time.Clock
use pkg.gojq.compiler.{CompiledCode, Runtime, call_callback, call_callback_pure}
use pkg.gojq.encoder.sorted_keys

pub struct Scope:
    id: i64
    offset: i64
    pc: i64
    saveindex: i64
    outerindex: i64

pub struct Fork:
    pc: i64
    stackindex: i64
    stacklimit: i64
    scopeindex: i64
    scopelimit: i64
    pathindex: i64
    pathlimit: i64
    offset: i64
    expdepth: i64

pub struct Env:
    pc: i64 = 0
    stack: Stack[Item]
    paths: Stack[PathValue]
    scopes: Stack[Scope]
    values: List[Item] = []
    codes: List[*Code] = []
    forks: List[Fork] = []
    backtrack: bool = false
    offset: i64 = 0
    expdepth: i64 = 0
    label: i64 = 0
    rt: *mut Runtime
    host_call: HostCall? = .None
    resume_call: HostCall? = .None
    host_result: Item? = .None
    ## env.args: the argument buffer of opcall, reused by every call
    args: List[Item] = []
    ## tags the arrays opappend made, which it may grow in place
    append_alloc: *mut Allocator

pub fn new_env(rt: *mut Runtime) -> *mut Env:
    box(Env { stack: Stack::new(), paths: Stack::new(), scopes: Stack::new(), rt: rt, append_alloc: box(Allocator {}) })

## Whether the error stops a try/alt fork without being caught (nil, breakError, HaltError).
fn uncatchable(err: JqError?) -> bool:
    match err:
        .None => true
        .Some(.Break(_, _)) => true
        .Some(.Halt(_, _)) => true
        _ => false

impl Env:
    pub fn execute(&mut self, bc: CompiledCode, v: Value, vars: List[Value]) -> void:
        self.codes = bc.codes
        self.push(.V(v))
        let i = vars.len()
        while i > 0:
            i -= 1
            self.push(.V(vars[i]))

    fn appended(&self, xs: *mut ArrBox) -> bool:
        match xs.alloc:
            .Some(a) => a is self.append_alloc
            .None => false

    fn push(&mut self, v: Item) -> void:
        self.stack.push(v)

    fn pop(&mut self) -> Item:
        self.stack.pop()

    fn popscope(&mut self) -> (i64, i64):
        free := self.scopes.index > self.scopes.limit
        s := self.scopes.top()
        _ := self.scopes.pop()
        if free:
            self.offset = s.offset
        (s.pc, s.saveindex)

    fn pushfork(&mut self, pc: i64) -> void:
        let (si, sl) = self.stack.save()
        let (ci, cl) = self.scopes.save()
        let (pi, pl) = self.paths.save()
        self.forks.push(Fork { pc: pc, stackindex: si, stacklimit: sl, scopeindex: ci, scopelimit: cl, pathindex: pi, pathlimit: pl, offset: self.offset, expdepth: self.expdepth })

    fn popfork(&mut self) -> i64:
        let .Some(f) = self.forks.pop() else:
            panic("popfork")
        self.offset = f.offset
        self.expdepth = f.expdepth
        self.stack.restore(f.stackindex, f.stacklimit)
        self.scopes.restore(f.scopeindex, f.scopelimit)
        self.paths.restore(f.pathindex, f.pathlimit)
        f.pc

    fn index(&self, id: i64, i: i64) -> usize:
        let s = self.scopes.index
        while s >= 0:
            sc := self.scopes.at(s)
            if sc.id == id:
                return usize(sc.offset + i)
            s = sc.outerindex
        panic("env.index")

    fn path_intact(&self, v: Value) -> bool:
        w := self.paths.top().value
        let .V(wv) = w else:
            return false
        match (v, wv):
            # Go allocates every empty slice at runtime.zerobase, so two empty
            # arrays share an address
            (.Arr(a), .Arr(b)) => a is b || (a.items.is_empty() && b.items.is_empty())
            (.Obj(a), .Obj(b)) => a is b
            (.Float(a), .Float(b)) => a == b || a.is_nan() && b.is_nan()
            _ => same(v, wv)

    fn poppaths(&mut self) -> List[Value]:
        let mut xs: List[Value] = []
        while true:
            p := self.paths.pop()
            match p.path:
                .None => break
                .Some(x) => xs.push(x)
        xs.reverse()
        xs

    fn tracking(&self) -> bool:
        !self.paths.empty() && self.expdepth == 0

    fn value_at(&self, id: i64, i: i64) -> Item:
        self.values[self.index(id, i)]

    fn store(&mut self, id: i64, i: i64, v: Item) -> void:
        k := self.index(id, i)
        self.values[k] = v

## An opcall of a callback that reads input, loads a module or reads the
## clock. The loop leaves to `next!` for it and resumes at the call with the
## result, so the loop itself never waits.
struct HostCall:
    f: Callback
    x: Item
    args: List[Item]
    name: string

impl Env:
    ## Next runs the code until the next output.
    pub fn next!(&mut self) -> Item? $ Console + ConsoleInput + FsRead + FsWrite + Clock:
        while true:
            r := self.run()
            match self.host_call:
                .Some(c) =>
                    self.host_call = .None
                    w := call_callback!(self.rt, c.f, c.x, c.args)
                    self.host_result = .Some(w)
                    self.resume_call = .Some(c)
                .None => return r
        .None

    fn run(&mut self) -> Item? $ Console:
        let mut err: JqError? = .None
        let pc = self.pc
        let callpc = i64(self.codes.len()) - 1
        let index = -1i64
        let backtrack = self.backtrack
        let result: Item? = .None
        let done = false
        # resuming after a host call: finish the opcall as the loop would
        let start_brk = false
        match (self.resume_call, self.host_result):
            (.Some(c), .Some(w)) =>
                self.resume_call = .None
                self.host_result = .None
                if self.op_call(w, c.x, c.args, c.name, &mut err):
                    start_brk = true
                else:
                    pc += 1
            _ => pass
        while !done:
            # `break loop` sets brk; `goto loop` continues without pc += 1
            let brk = false
            while !start_brk && pc < i64(self.codes.len()):
                code := self.codes[usize(pc)]
                let jumped = false
                match code.op:
                    .OpNop => pass
                    .OpPush =>
                        match code.v:
                            .Val(v) => self.push(.V(v))
                            _ => self.push(.V(.Null))
                    .OpPop => _ := self.pop()
                    .OpDup =>
                        v := self.pop()
                        self.push(v)
                        self.push(v)
                    .OpConst =>
                        _ := self.pop()
                        match code.v:
                            .Val(v) => self.push(.V(v))
                            _ => self.push(.V(.Null))
                    .OpLoad =>
                        let .Var(a, b) = code.v else: panic("opload")
                        self.push(self.value_at(a, b))
                    .OpStore =>
                        let .Var(a, b) = code.v else: panic("opstore")
                        v := self.pop()
                        self.store(a, b, v)
                    .OpObject =>
                        if backtrack:
                            brk = true
                        else:
                            let .Int(n) = code.v else: panic("opobject")
                            let mut m: Map[string, Value] = {}
                            for _ in 0..n:
                                v := item_value(self.pop())
                                k := item_value(self.pop())
                                let .Str(s) = k else:
                                    err = .Some(.ObjectKeyNotString(k))
                                    brk = true
                                    break
                                if !m.contains_key(s):
                                    m[s] = v
                            if !brk:
                                self.push(.V(obj(m)))
                    .OpAppend =>
                        let .Var(a, b) = code.v else: panic("opappend")
                        i := self.index(a, b)
                        x := item_value(self.pop())
                        # Go's append owns the slice it grows; here the first
                        # append copies the array (the constant `[]` of the
                        # code is shared) and later ones grow that copy.
                        match self.values[i]:
                            .V(.Arr(xs)) =>
                                if self.appended(xs):
                                    xs.items.push(x)
                                else:
                                    let mut ys = xs.items
                                    ys.push(x)
                                    self.values[i] = .V(.Arr(box(ArrBox { items: ys, alloc: .Some(self.append_alloc), gen: 1 })))
                            _ => panic("opappend")
                    .OpFork =>
                        if backtrack:
                            if err.is_some():
                                brk = true
                            else:
                                let .Int(t) = code.v else: panic("opfork")
                                pc = t
                                backtrack = false
                                jumped = true
                        else:
                            self.pushfork(pc)
                    .OpForkTryBegin =>
                        if backtrack:
                            match err:
                                .Some(.TryEnd(inner)) =>
                                    err = .Some(*inner)
                                    brk = true
                                _ =>
                                    if uncatchable(err):
                                        brk = true
                                    else:
                                        e := err.unwrap_or(.Message(""))
                                        _ := self.pop()
                                        match value_of(e):
                                            .Some(v) => self.push(.V(v))
                                            .None => self.push(.V(.Str(error_string(e))))
                                        let .Int(t) = code.v else: panic("opforktrybegin")
                                        pc = t
                                        backtrack = false
                                        err = .None
                                        jumped = true
                        else:
                            self.pushfork(pc)
                    .OpForkTryEnd =>
                        if backtrack:
                            if !uncatchable(err):
                                err = .Some(.TryEnd(box(err.unwrap_or(.Message("")))))
                            brk = true
                        else:
                            self.pushfork(pc)
                    .OpForkAlt =>
                        if backtrack:
                            if uncatchable(err):
                                brk = true
                            else:
                                let .Int(t) = code.v else: panic("opforkalt")
                                pc = t
                                backtrack = false
                                err = .None
                                jumped = true
                        else:
                            self.pushfork(pc)
                    .OpForkLabel =>
                        if backtrack:
                            label := self.pop()
                            match (err, label):
                                (.Some(.Break(_, .Int(l))), .V(.Int(m))) =>
                                    if l == m:
                                        err = .None
                                _ => pass
                            brk = true
                        else:
                            self.push(.V(.Int(self.label)))
                            self.pushfork(pc)
                            _ := self.pop()
                            let .Var(a, b) = code.v else: panic("opforklabel")
                            self.store(a, b, .V(.Int(self.label)))
                            self.label += 1
                    .OpBacktrack => brk = true
                    .OpJump =>
                        let .Int(t) = code.v else: panic("opjump")
                        pc = t
                        jumped = true
                    .OpJumpIfNot =>
                        v := item_value(self.pop())
                        if is_falsy(v):
                            let .Int(t) = code.v else: panic("opjumpifnot")
                            pc = t
                            jumped = true
                    .OpIndex =>
                        if backtrack:
                            brk = true
                        else:
                            brk = self.op_index(code, false, &mut err)
                    .OpIndexArray =>
                        if backtrack:
                            brk = true
                        else:
                            brk = self.op_index(code, true, &mut err)
                    .OpCall =>
                        if backtrack:
                            brk = true
                        else:
                            match code.v:
                                .Int(t) =>
                                    callpc = pc
                                    pc = t
                                    index = self.scopes.index
                                    jumped = true
                                .Call(f, argc, name) =>
                                    x := self.pop()
                                    self.args.truncate(0)
                                    for _ in 0..argc:
                                        a := self.pop()
                                        self.args.push(a)
                                    args := self.args
                                    let host = match f:
                                        .Input => true
                                        .Modulemeta => true
                                        .Now => true
                                        .Custom(_) => true
                                        _ => false
                                    if host:
                                        self.host_call = .Some(HostCall { f: f, x: x, args: args, name: name })
                                        self.pc = pc
                                        self.backtrack = false
                                        return .None
                                    w := call_callback_pure(f, x, args)
                                    brk = self.op_call(w, x, args, name, &mut err)
                                _ => panic("opcall")
                    .OpCallRec =>
                        let .Int(t) = code.v else: panic("opcallrec")
                        pc = t
                        callpc = -1
                        index = self.scopes.index
                        jumped = true
                    .OpPushPc =>
                        let .Int(t) = code.v else: panic("oppushpc")
                        self.push(.Pc(t, self.scopes.index))
                    .OpCallPc =>
                        let .Pc(p, s) = self.pop() else: panic("opcallpc")
                        callpc = pc
                        pc = p
                        index = s
                        jumped = true
                    .OpScope =>
                        let .Scope(id, cnt, _) = code.v else: panic("opscope")
                        let saveindex = 0i64
                        if index == self.scopes.index:
                            if callpc >= 0:
                                saveindex = index
                            else:
                                let (cp, si) = self.popscope()
                                callpc = cp
                                saveindex = si
                        else:
                            saveindex = self.scopes.index
                        let outerindex = index
                        if outerindex >= 0:
                            s := self.scopes.at(outerindex)
                            if s.id == id:
                                outerindex = s.outerindex
                        self.scopes.push(Scope { id: id, offset: self.offset, pc: callpc, saveindex: saveindex, outerindex: outerindex })
                        self.offset += cnt
                        while self.offset > i64(self.values.len()):
                            self.values.push(.V(.Null))
                    .OpRet =>
                        if backtrack:
                            brk = true
                        else:
                            let (p, si) = self.popscope()
                            pc = p
                            self.scopes.index = si
                            if self.scopes.empty():
                                self.pc = pc
                                self.backtrack = true
                                return .Some(self.pop())
                    .OpIter =>
                        if err.is_some():
                            brk = true
                        else:
                            backtrack = false
                            match self.op_iter(pc, &mut err):
                                0 => pass
                                1 => brk = true
                                _ => pass
                    .OpExpBegin => self.expdepth += 1
                    .OpExpEnd => self.expdepth -= 1
                    .OpPathBegin =>
                        self.paths.push(PathValue { path: .None, value: .V(.Int(self.expdepth)) })
                        self.paths.push(PathValue { path: .None, value: self.stack.top() })
                        self.expdepth = 0
                    .OpPathEnd =>
                        if backtrack:
                            brk = true
                        else:
                            _ := self.pop()
                            v := item_value(self.pop())
                            if !self.path_intact(v):
                                err = .Some(.InvalidPath(v))
                                brk = true
                            else:
                                self.push(.V(arr(self.poppaths())))
                                match self.paths.pop().value:
                                    .V(.Int(d)) => self.expdepth = d
                                    _ => panic("pathend")
                if brk:
                    break
                if !jumped:
                    pc += 1
            start_brk = false
            if self.forks.len() > 0:
                pc = self.popfork()
                backtrack = true
                continue
            done = true
        self.pc = pc
        self.backtrack = true
        match err:
            .Some(e) => .Some(.Err(e))
            .None => .None

impl Env:
    ## opindex and opindexarray; returns whether to break the loop.
    fn op_index(&mut self, code: *Code, is_array: bool, err: &mut (JqError?)) -> bool:
        let .Val(p) = code.v else: panic("opindex")
        v := item_value(self.pop())
        if is_array:
            match v:
                .Null => pass
                .Arr(_) => pass
                _ =>
                    *err = .Some(.ExpectedArray(v))
                    return true
        match func_index2(.Null, v, p):
            .Err(e) =>
                *err = .Some(e)
                return true
            .V(w) =>
                self.push(.V(w))
                if self.tracking():
                    if !self.path_intact(v):
                        *err = .Some(.InvalidPath(v))
                        return true
                    self.paths.push(PathValue { path: .Some(p), value: .V(w) })
            _ => panic("opindex")
        false

    ## opcall of a native function; returns whether to break the loop.
    fn op_call(&mut self, w: Item, x: Item, args: List[Item], name: string, err: &mut (JqError?)) -> bool:
        match w:
            .Err(e) =>
                *err = .Some(e)
                return true
            _ => pass
        self.push(w)
        if self.tracking():
            match name:
                "_index" =>
                    a0 := item_value(args[0])
                    if !self.path_intact(a0):
                        *err = .Some(.InvalidPath(a0))
                        return true
                    self.paths.push(PathValue { path: .Some(item_value(args[1])), value: w })
                "_slice" =>
                    a0 := item_value(args[0])
                    if !self.path_intact(a0):
                        *err = .Some(.InvalidPath(a0))
                        return true
                    let mut m: Map[string, Value] = {}
                    m["start"] = item_value(args[2])
                    m["end"] = item_value(args[1])
                    self.paths.push(PathValue { path: .Some(obj(m)), value: w })
                "getpath" =>
                    xv := item_value(x)
                    if !self.path_intact(xv):
                        *err = .Some(.InvalidPath(xv))
                        return true
                    match item_value(args[0]):
                        .Arr(ps) =>
                            for p in ps.items:
                                self.paths.push(PathValue { path: .Some(p), value: w })
                        _ => pass
                _ => pass
        false

    ## opiter; returns 1 to break the loop.
    fn op_iter(&mut self, pc: i64, err: &mut (JqError?)) -> i64:
        let mut xs: List[PathValue] = []
        let start = 0usize
        match self.pop():
            .Paths(ps, k) =>
                xs = ps
                start = k
            .V(.Arr(a)) =>
                if self.tracking() && !self.path_intact(.Arr(a)):
                    *err = .Some(.InvalidPathIter(.Arr(a)))
                    self.push(.Empty)
                    return 1
                if a.items.is_empty():
                    return 1
                for (i, v) in a.items.iter().enumerate():
                    xs.push(PathValue { path: .Some(.Int(i64(i))), value: .V(v) })
            .V(.Obj(m)) =>
                if self.tracking() && !self.path_intact(.Obj(m)):
                    *err = .Some(.InvalidPathIter(.Obj(m)))
                    self.push(.Empty)
                    return 1
                if m.fields.is_empty():
                    return 1
                for k in sorted_keys(m.fields):
                    xs.push(PathValue { path: .Some(.Str(k)), value: .V(m.fields[k]) })
            .It(it) =>
                match it.next():
                    .Some(w) =>
                        self.push(.It(it))
                        self.pushfork(pc)
                        _ := self.pop()
                        match w:
                            .Err(e) =>
                                *err = .Some(e)
                                return 1
                            _ => pass
                        self.push(w)
                        return 0
                    .None => return 1
            .Empty => return 1
            .V(v) =>
                *err = .Some(.Iterator(v))
                self.push(.Empty)
                return 1
            _ => panic("opiter")
        if xs.len() - start > 1:
            self.push(.Paths(xs, start + 1))
            self.pushfork(pc)
            _ := self.pop()
        self.push(xs[start].value)
        if self.tracking():
            self.paths.push(xs[start])
        0

## Code.Run: runs the code with the variable values (in the order given with
## WithVariables); the results come from `next!` of the environment.
pub fn run_code(c: CompiledCode, v: Value, values: List[Value]) -> Result[*mut Env, JqError]:
    if values.len() > c.variables.len():
        return .Err(.TooManyVariableValues)
    if values.len() < c.variables.len():
        return .Err(.ExpectedVariable(c.variables[values.len()]))
    env := new_env(c.rt)
    env.execute(c, v, values)
    .Ok(env)
