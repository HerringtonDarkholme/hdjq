## Shim for the parts of Go's time package gojq and timefmt-go use: Time
## (Unix seconds, nanoseconds, location), Location (fixed or loaded from a
## TZif file), Date with Go's normalization, and the calendar accessors.
## Zone rules past the last transition of a TZif file (its POSIX footer) are
## not applied; the bundled files carry transitions up to 2037.
use std.fs.{FsRead, read_bytes}
use std.path.Path

ALPHA := -9223372036854775807i64 - 1
OMEGA := 9223372036854775807i64

pub struct Zone:
    pub name: string
    pub offset: i64
    pub is_dst: bool

pub struct Location:
    pub name: string
    pub zones: List[Zone] = []
    ## transition times (Unix seconds) and the zone index from each
    pub tx_when: List[i64] = []
    pub tx_index: List[usize] = []

pub fn utc() -> *mut Location:
    box(Location { name: "UTC" })

## time.FixedZone
pub fn fixed_zone(name: string, offset: i64) -> *mut Location:
    box(Location { name: name, zones: [Zone { name: name, offset: offset, is_dst: false }], tx_when: [ALPHA], tx_index: [0] })

pub struct Lookup:
    pub name: string
    pub offset: i64
    pub start: i64
    pub end: i64

impl Location:
    pub fn string(&self) -> string:
        self.name

    fn lookup_first_zone(&self) -> usize:
        # Case 1: the first zone is unused by transitions.
        if !self.first_zone_used():
            return 0
        # Case 2: the first transition is to a daylight zone.
        if !self.tx_index.is_empty() && self.zones[self.tx_index[0]].is_dst:
            let zi = i64(self.tx_index[0]) - 1
            while zi >= 0:
                if !self.zones[usize(zi)].is_dst:
                    return usize(zi)
                zi -= 1
        # Case 3: the first zone that is not daylight time.
        for (i, z) in self.zones.iter().enumerate():
            if !z.is_dst:
                return i
        0

    fn first_zone_used(&self) -> bool:
        for i in self.tx_index:
            if i == 0:
                return true
        false

    pub fn lookup(&self, sec: i64) -> Lookup:
        if self.zones.is_empty():
            return Lookup { name: "UTC", offset: 0, start: ALPHA, end: OMEGA }
        if self.tx_when.is_empty() || sec < self.tx_when[0]:
            z := self.zones[self.lookup_first_zone()]
            end := if self.tx_when.is_empty(): OMEGA else: self.tx_when[0]
            return Lookup { name: z.name, offset: z.offset, start: ALPHA, end: end }
        let end = OMEGA
        let lo = 0usize
        let hi = self.tx_when.len()
        while hi - lo > 1:
            m := (lo + hi) / 2
            lim := self.tx_when[m]
            if sec < lim:
                end = lim
                hi = m
            else:
                lo = m
        z := self.zones[self.tx_index[lo]]
        Lookup { name: z.name, offset: z.offset, start: self.tx_when[lo], end: end }

    ## lookupName: the offset of the zone named `name` in effect near unix.
    pub fn lookup_name(&self, name: string, unix: i64) -> i64?:
        for z in self.zones:
            if z.name == name:
                l := self.lookup(unix - z.offset)
                if l.name == z.name:
                    return .Some(l.offset)
        for z in self.zones:
            if z.name == name:
                return .Some(z.offset)
        .None

fn be32(b: List[u8], i: usize) -> i64:
    v := (i64(b[i]) << 24) | (i64(b[i + 1]) << 16) | (i64(b[i + 2]) << 8) | i64(b[i + 3])
    if v >= 2147483648: v - 4294967296 else: v

## Reads a TZif file (its version 1 data block).
pub fn load_tzif(name: string, b: List[u8]) -> (*mut Location)?:
    if b.len() < 44 || b[0] != 0x54 || b[1] != 0x5a || b[2] != 0x69 || b[3] != 0x66:
        return .None
    isutcnt := usize(be32(b, 20))
    isstdcnt := usize(be32(b, 24))
    leapcnt := usize(be32(b, 28))
    timecnt := usize(be32(b, 32))
    typecnt := usize(be32(b, 36))
    charcnt := usize(be32(b, 40))
    let p = 44usize
    need := p + timecnt * 5 + typecnt * 6 + charcnt + leapcnt * 8 + isstdcnt + isutcnt
    if b.len() < need || typecnt == 0:
        return .None
    let mut when: List[i64] = []
    for i in 0..timecnt:
        when.push(be32(b, p + i * 4))
    p += timecnt * 4
    let mut idx: List[usize] = []
    for i in 0..timecnt:
        idx.push(usize(b[p + i]))
    p += timecnt
    zp := p
    p += typecnt * 6
    chars := b.slice(p, p + charcnt)
    let mut zones: List[Zone] = []
    for i in 0..typecnt:
        off := be32(b, zp + i * 6)
        dst := b[zp + i * 6 + 4] != 0
        let ai = usize(b[zp + i * 6 + 5])
        let mut nm: List[u8] = []
        while ai < chars.len() && chars[ai] != 0:
            nm.push(chars[ai])
            ai += 1
        zones.push(Zone { name: string::from_utf8(nm).unwrap_or(""), offset: off, is_dst: dst })
    for i in idx:
        if i >= zones.len():
            return .None
    .Some(box(Location { name: name, zones: zones, tx_when: when, tx_index: idx }))

## time.LoadLocation from the system zoneinfo directories.
pub fn load_location!(name: string) -> (*mut Location)? $ FsRead:
    if name == "" || name == "UTC":
        return .Some(utc())
    for dir in ["/usr/share/zoneinfo/", "/usr/share/lib/zoneinfo/", "/usr/lib/locale/TZ/", "/etc/zoneinfo/"]:
        match read_bytes!(Path(dir + name)):
            .Ok(b) => return load_tzif(name, b)
            .Err(_) => pass
    .None

# time.Local: UTC rules until init_local! loads the zone.
let LOCAL = box(Location { name: "Local" })

## time.Local
pub fn local() -> *mut Location:
    LOCAL

## initLocal: the TZ value (`.None` when unset) chooses the local zone; it
## is named "Local", and falls back to UTC. Go runs it on first use of
## time.Local; reading a file needs a waiting call here, so the program
## runs it before compiling.
pub fn init_local!(tz: string?) -> void $ FsRead:
    LOCAL = load_local!(tz)

fn load_local!(tz: string?) -> *mut Location $ FsRead:
    let found: (*mut Location)? = .None
    match tz:
        .None =>
            match read_bytes!(Path("/etc/localtime")):
                .Ok(b) => found = load_tzif("Local", b)
                .Err(_) => pass
        .Some(t0) =>
            let t = t0
            if t.starts_with(":"):
                t = t.slice(1, t.len())
            if t != "" && t.starts_with("/"):
                match read_bytes!(Path(t)):
                    .Ok(b) => found = load_tzif("Local", b)
                    .Err(_) => pass
            else if t != "" && t != "UTC":
                found = load_location!(t)
    match found:
        .Some(l) =>
            l.name = "Local"
            l
        .None => box(Location { name: "UTC" })

# ---------------------------------------------------------------- Time

pub struct Time:
    pub sec: i64
    pub nsec: i64
    pub loc: *mut Location

fn floor_div(a: i64, b: i64) -> i64:
    q := a / b
    if (a % b != 0) && ((a < 0) != (b < 0)): q - 1 else: q

fn floor_mod(a: i64, b: i64) -> i64:
    a - floor_div(a, b) * b

pub fn days_from_civil(y0: i64, m: i64, d: i64) -> i64:
    y := if m <= 2: y0 - 1 else: y0
    era := floor_div(y, 400)
    yoe := y - era * 400
    mp := if m > 2: m - 3 else: m + 9
    doy := (153 * mp + 2) / 5 + d - 1
    doe := yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468

pub fn civil_from_days(z0: i64) -> (i64, i64, i64):
    z := z0 + 719468
    era := floor_div(z, 146097)
    doe := z - era * 146097
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    y := yoe + era * 400
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp := (5 * doy + 2) / 153
    d := doy - (153 * mp + 2) / 5 + 1
    m := if mp < 10: mp + 3 else: mp - 9
    (if m <= 2: y + 1 else: y, m, d)

## time.Unix(sec, nsec), normalizing nsec into [0, 1e9).
pub fn unix(sec: i64, nsec: i64) -> Time:
    let s = sec
    let n = nsec
    if n < 0 || n >= 1000000000:
        q := floor_div(n, 1000000000)
        s += q
        n -= q * 1000000000
    Time { sec: s, nsec: n, loc: box(Location { name: "Local" }) }

fn norm(hi: i64, lo: i64, base: i64) -> (i64, i64):
    let h = hi
    let l = lo
    if l < 0:
        n := (-l - 1) / base + 1
        h -= n
        l += n * base
    if l >= base:
        n := l / base
        h += n
        l -= n * base
    (h, l)

## time.Date, with Go's normalization of out-of-range fields.
pub fn date(year0: i64, month0: i64, day0: i64, hour0: i64, min0: i64, sec0: i64, nsec0: i64, loc: *mut Location) -> Time:
    let (year, m) = norm(year0, month0 - 1, 12)
    let (sec1, nsec) = norm(sec0, nsec0, 1000000000)
    let (min1, sec) = norm(min0, sec1, 60)
    let (hour1, min) = norm(hour0, min1, 60)
    let (day, hour) = norm(day0, hour1, 24)
    days := days_from_civil(year, m + 1, 1) + day - 1
    let u = days * 86400 + hour * 3600 + min * 60 + sec
    l := loc.lookup(u)
    let offset = l.offset
    if offset != 0:
        utc := u - offset
        if utc < l.start || utc >= l.end:
            offset = loc.lookup(utc).offset
        u -= offset
    Time { sec: u, nsec: nsec, loc: loc }

impl Time:
    pub fn in_loc(&self, loc: *mut Location) -> Time:
        Time { sec: self.sec, nsec: self.nsec, loc: loc }

    pub fn utc(&self) -> Time:
        self.in_loc(utc())

    pub fn location(&self) -> *mut Location:
        self.loc

    pub fn unix(&self) -> i64:
        self.sec

    pub fn nanosecond(&self) -> i64:
        self.nsec

    ## Zone: the zone name and offset in effect.
    pub fn zone(&self) -> (string, i64):
        l := self.loc.lookup(self.sec)
        (l.name, l.offset)

    fn local_secs(&self) -> i64:
        self.sec + self.loc.lookup(self.sec).offset

    fn days(&self) -> i64:
        floor_div(self.local_secs(), 86400)

    ## Date: year, month (1-12) and day.
    pub fn date(&self) -> (i64, i64, i64):
        civil_from_days(self.days())

    ## Year; Go's absolute time wraps around below this many seconds, giving
    ## a year far in the future.
    pub fn year(&self) -> i64:
        if self.sec < -9223372028715321600:
            return 9223372036854775807
        self.date()._0

    ## Clock: hour, minute and second.
    pub fn clock(&self) -> (i64, i64, i64):
        s := floor_mod(self.local_secs(), 86400)
        (s / 3600, s / 60 % 60, s % 60)

    ## Weekday: 0 for Sunday.
    pub fn weekday(&self) -> i64:
        floor_mod(self.days() + 4, 7)

    ## YearDay: 1 to 366.
    pub fn year_day(&self) -> i64:
        d := self.days()
        let (y, _, _) = civil_from_days(d)
        d - days_from_civil(y, 1, 1) + 1

    ## ISOWeek: the ISO 8601 year and week.
    pub fn iso_week(&self) -> (i64, i64):
        let d = 4 - self.weekday()
        if d == 4:
            d = -3
        day := self.days() + d
        let (y, _, _) = civil_from_days(day)
        yday := day - days_from_civil(y, 1, 1)
        (y, yday / 7 + 1)

# ---------------------------------------------------------------- ParseInLocation("MST", ...)

fn parse_gmt(value: string) -> usize:
    v := value.slice(3, value.len())
    if v.is_empty():
        return 3
    n := parse_signed_offset(v)
    if n == 0: 3 else: 3 + n

fn parse_signed_offset(value: string) -> usize:
    let b: List[u8] = value.bytes().collect()
    if b.is_empty() || (b[0] != 0x2b && b[0] != 0x2d):
        return 0
    let i = 1usize
    let x = 0i64
    while i < b.len() && b[i] >= 0x30 && b[i] <= 0x39:
        x = x * 10 + i64(b[i] - 0x30)
        i += 1
        if x > 1000000:
            return 0
    if i == 1 || x > 23:
        return 0
    i

## parseTimeZone: the length of a zone abbreviation at the start of value.
fn parse_time_zone(value: string) -> usize?:
    let b: List[u8] = value.bytes().collect()
    if b.len() < 3:
        return .None
    if b.len() >= 4 && (value.slice(0, 4) == "ChST" || value.slice(0, 4) == "MeST"):
        return .Some(4)
    if value.slice(0, 3) == "GMT":
        return .Some(parse_gmt(value))
    if b[0] == 0x2b || b[0] == 0x2d:
        n := parse_signed_offset(value)
        return if n > 0: .Some(n) else: .None
    let n = 0usize
    while n < 6 && n < b.len() && b[n] >= 0x41 && b[n] <= 0x5a:
        n += 1
    match n:
        3 => .Some(3)
        4 =>
            if b[3] == 0x54 || value.slice(0, 4) == "WITA": .Some(4) else: .None
        5 =>
            if b[4] == 0x54: .Some(5) else: .None
        _ => .None

## The location `time.ParseInLocation("MST", name, base)` gives its result,
## or `.None` for a parse error.
pub fn parse_zone_name(name: string, base: *mut Location) -> (*mut Location)?:
    if name.starts_with("UTC"):
        if name.len() == 3:
            return .Some(utc())
        return .None
    let .Some(n) = parse_time_zone(name) else:
        return .None
    if n != name.len():
        return .None
    # Go parses the zone at 0000-01-01 00:00 UTC.
    t := days_from_civil(0, 1, 1) * 86400
    match base.lookup_name(name, t):
        .Some(_) => return .Some(base)
        .None => pass
    let offset = 0i64
    if name.len() > 3 && name.slice(0, 3) == "GMT":
        offset = name.slice(3, name.len()).parse::[i64]().unwrap_or(0) * 3600
    .Some(fixed_zone(name, offset))
