## r/s for the asymptotic helpers: p has 6 entries, q has 5.
fn bessel_ratio5(p: List[f64], q: List[f64], z: f64) -> f64:
    r := fma(z, fma(z, fma(z, fma(z, fma(z, p[5], p[4]), p[3]), p[2]), p[1]), p[0])
    s := fma(z, fma(z, fma(z, fma(z, fma(z, q[4], q[3]), q[2]), q[1]), q[0]), 1.0)
    r / s

## r/s for the asymptotic helpers: p and q both have 6 entries.
fn bessel_ratio6(p: List[f64], q: List[f64], z: f64) -> f64:
    r := fma(z, fma(z, fma(z, fma(z, fma(z, p[5], p[4]), p[3]), p[2]), p[1]), p[0])
    s := fma(z, fma(z, fma(z, fma(z, fma(z, fma(z, q[5], q[4]), q[3]), q[2]), q[1]), q[0]), 1.0)
    r / s

fn pzero(x: f64) -> f64:
    z := 1.0 / (x * x)
    if x >= 8.0:
        return 1.0 + bessel_ratio5(P0R8, P0S8, z)
    if x >= 4.5454:
        return 1.0 + bessel_ratio5(P0R5, P0S5, z)
    if x >= 2.8571:
        return 1.0 + bessel_ratio5(P0R3, P0S3, z)
    1.0 + bessel_ratio5(P0R2, P0S2, z)

fn qzero(x: f64) -> f64:
    z := 1.0 / (x * x)
    let rs = 0.0
    if x >= 8.0:
        rs = bessel_ratio6(Q0R8, Q0S8, z)
    else if x >= 4.5454:
        rs = bessel_ratio6(Q0R5, Q0S5, z)
    else if x >= 2.8571:
        rs = bessel_ratio6(Q0R3, Q0S3, z)
    else:
        rs = bessel_ratio6(Q0R2, Q0S2, z)
    (-0.125 + rs) / x

fn pone(x: f64) -> f64:
    z := 1.0 / (x * x)
    if x >= 8.0:
        return 1.0 + bessel_ratio5(P1R8, P1S8, z)
    if x >= 4.5454:
        return 1.0 + bessel_ratio5(P1R5, P1S5, z)
    if x >= 2.8571:
        return 1.0 + bessel_ratio5(P1R3, P1S3, z)
    1.0 + bessel_ratio5(P1R2, P1S2, z)

fn qone(x: f64) -> f64:
    z := 1.0 / (x * x)
    let rs = 0.0
    if x >= 8.0:
        rs = bessel_ratio6(Q1R8, Q1S8, z)
    else if x >= 4.5454:
        rs = bessel_ratio6(Q1R5, Q1S5, z)
    else if x >= 2.8571:
        rs = bessel_ratio6(Q1R3, Q1S3, z)
    else:
        rs = bessel_ratio6(Q1R2, Q1S2, z)
    (0.375 + rs) / x

## Bessel function of the first kind, order zero.
pub fn j0(x0: f64) -> f64:
    r02 := 1.56249999999999947958e-02
    r03 := -1.89979294238854721751e-04
    r04 := 1.82954049532700665670e-06
    r05 := -4.61832688532103189199e-09
    s01 := 1.56191029464890010492e-02
    s02 := 1.16926784663337450260e-04
    s03 := 5.13546550207318111446e-07
    s04 := 1.16614003333790000205e-09
    if is_nan(x0):
        return x0
    if is_inf(x0, 0):
        return 0.0
    if x0 == 0.0:
        return 1.0
    x := x0.abs()
    if x >= 2.0:
        let (s, c) = sincos(x)
        let ss = s - c
        let cc = s + c
        if x < HALF_MAX_FLOAT64:
            z := -cos(x + x)
            if s * c < 0.0:
                cc = z / ss
            else:
                ss = z / cc
        if x > TWO129:
            return INV_SQRTPI * cc / x.sqrt()
        u := pzero(x)
        v := qzero(x)
        return INV_SQRTPI * fma(-v, ss, u * cc) / x.sqrt()
    if x < TWOM13:
        if x < TWOM27:
            return 1.0
        return fma(-(0.25 * x), x, 1.0)
    z := x * x
    r := z * fma(z, fma(z, fma(z, r05, r04), r03), r02)
    s := fma(z, fma(z, fma(z, fma(z, s04, s03), s02), s01), 1.0)
    if x < 1.0:
        return fma(z, -0.25 + r / s, 1.0)
    # (1+u)*(1-u) with u = 0.5*x; Go fuses u into both factors.
    fma(z, r / s, fma(x, 0.5, 1.0) * fma(-x, 0.5, 1.0))

## Bessel function of the second kind, order zero.
pub fn y0(x: f64) -> f64:
    u00 := -7.38042951086872317523e-02
    u01 := 1.76666452509181115538e-01
    u02 := -1.38185671945596898896e-02
    u03 := 3.47453432093683650238e-04
    u04 := -3.81407053724364161125e-06
    u05 := 1.95590137035022920206e-08
    u06 := -3.98205194132103398453e-11
    v01 := 1.27304834834123699328e-02
    v02 := 7.60068627350353253702e-05
    v03 := 2.59150851840457805467e-07
    v04 := 4.41110311332675467403e-10
    if x < 0.0 || is_nan(x):
        return nan()
    if is_inf(x, 1):
        return 0.0
    if x == 0.0:
        return inf(-1)
    if x >= 2.0:
        let (s, c) = sincos(x)
        let ss = s - c
        let cc = s + c
        if x < HALF_MAX_FLOAT64:
            z := -cos(x + x)
            if s * c < 0.0:
                cc = z / ss
            else:
                ss = z / cc
        if x > TWO129:
            return INV_SQRTPI * ss / x.sqrt()
        u := pzero(x)
        v := qzero(x)
        return INV_SQRTPI * fma(v, cc, u * ss) / x.sqrt()
    if x <= TWOM27:
        return fma(TWO_OVER_PI, log(x), u00)
    z := x * x
    u := fma(z, fma(z, fma(z, fma(z, fma(z, fma(z, u06, u05), u04), u03), u02), u01), u00)
    v := fma(z, fma(z, fma(z, fma(z, v04, v03), v02), v01), 1.0)
    fma(TWO_OVER_PI * j0(x), log(x), u / v)

## Bessel function of the first kind, order one.
pub fn j1(x0: f64) -> f64:
    r00 := -6.25000000000000000000e-02
    r01 := 1.40705666955189706048e-03
    r02 := -1.59955631084035597520e-05
    r03 := 4.96727999609584448412e-08
    s01 := 1.91537599538363460805e-02
    s02 := 1.85946785588630915560e-04
    s03 := 1.17718464042623683263e-06
    s04 := 5.04636257076217042715e-09
    s05 := 1.23542274426137913908e-11
    if is_nan(x0):
        return x0
    if is_inf(x0, 0) || x0 == 0.0:
        return 0.0
    let x = x0
    let sign = false
    if x < 0.0:
        x = -x
        sign = true
    if x >= 2.0:
        let (s, c) = sincos(x)
        let ss = -s - c
        let cc = s - c
        if x < HALF_MAX_FLOAT64:
            z := cos(x + x)
            if s * c > 0.0:
                cc = z / ss
            else:
                ss = z / cc
        let z = 0.0
        if x > TWO129:
            z = INV_SQRTPI * cc / x.sqrt()
        else:
            u := pone(x)
            v := qone(x)
            z = INV_SQRTPI * fma(-v, ss, u * cc) / x.sqrt()
        if sign:
            return -z
        return z
    if x < TWOM27:
        return 0.5 * x
    z := x * x
    let r = z * fma(z, fma(z, fma(z, r03, r02), r01), r00)
    s := fma(z, fma(z, fma(z, fma(z, fma(z, s05, s04), s03), s02), s01), 1.0)
    r = r * x
    let w = fma(0.5, x, r / s)
    if sign:
        w = -w
    w

## Bessel function of the second kind, order one.
pub fn y1(x: f64) -> f64:
    u00 := -1.96057090646238940668e-01
    u01 := 5.04438716639811282616e-02
    u02 := -1.91256895875763547298e-03
    u03 := 2.35252600561610495928e-05
    u04 := -9.19099158039878874504e-08
    v00 := 1.99167318236649903973e-02
    v01 := 2.02552581025135171496e-04
    v02 := 1.35608801097516229404e-06
    v03 := 6.22741452364621501295e-09
    v04 := 1.66559246207992079114e-11
    if x < 0.0 || is_nan(x):
        return nan()
    if is_inf(x, 1):
        return 0.0
    if x == 0.0:
        return inf(-1)
    if x >= 2.0:
        let (s, c) = sincos(x)
        let ss = -s - c
        let cc = s - c
        if x < HALF_MAX_FLOAT64:
            z := cos(x + x)
            if s * c > 0.0:
                cc = z / ss
            else:
                ss = z / cc
        if x > TWO129:
            return INV_SQRTPI * ss / x.sqrt()
        u := pone(x)
        v := qone(x)
        return INV_SQRTPI * fma(u, ss, v * cc) / x.sqrt()
    if x <= TWOM54:
        return NEG_TWO_OVER_PI / x
    z := x * x
    u := fma(z, fma(z, fma(z, fma(z, u04, u03), u02), u01), u00)
    v := fma(z, fma(z, fma(z, fma(z, fma(z, v04, v03), v02), v01), v00), 1.0)
    inner := fma(j1(x), log(x), -(1.0 / x))
    fma(x, u / v, TWO_OVER_PI * inner)

## Bessel function of the first kind, order n.
pub fn jn(n0: i64, x0: f64) -> f64:
    if is_nan(x0):
        return x0
    if is_inf(x0, 0):
        return 0.0
    if n0 == 0:
        return j0(x0)
    if x0 == 0.0:
        return 0.0
    let n = n0
    let x = x0
    if n < 0:
        n = -n
        x = -x
    if n == 1:
        return j1(x)
    let sign = false
    if x < 0.0:
        x = -x
        if n & 1 == 1:
            sign = true
    let b = 0.0
    if f64(n) <= x:
        if x >= TWO302:
            let (s, c) = sincos(x)
            let temp = 0.0
            nm := n & 3
            if nm == 0:
                temp = c + s
            else if nm == 1:
                temp = -c + s
            else if nm == 2:
                temp = -c - s
            else:
                temp = c - s
            b = INV_SQRTPI * temp / x.sqrt()
        else:
            b = j1(x)
            let a = j0(x)
            let i = 1i64
            while i < n:
                t := fma(b, f64(i + i) / x, -a)
                a = b
                b = t
                i += 1
    else:
        if x < TWOM29:
            if n > 33:
                b = 0.0
            else:
                temp := x * 0.5
                b = temp
                let a = 1.0
                let i = 2i64
                while i <= n:
                    a = a * f64(i)
                    b = b * temp
                    i += 1
                b = b / a
        else:
            w := f64(n + n) / x
            h := 2.0 / x
            let q0 = w
            let z = w + h
            let q1 = fma(w, z, -1.0)
            let k = 1i64
            while q1 < 1e9:
                k += 1
                z = z + h
                t := fma(z, q1, -q0)
                q0 = q1
                q1 = t
            m := n + n
            let t = 0.0
            let i = 2 * (n + k)
            while i >= m:
                t = 1.0 / (f64(i) / x - t)
                i -= 2
            let a = t
            b = 1.0
            let tmp = f64(n)
            v := 2.0 / x
            tmp = tmp * log((v * tmp).abs())
            if tmp < 7.09782712893383973096e+02:
                let i2 = n - 1
                while i2 > 0:
                    di := f64(i2 + i2)
                    nb := b * di / x - a
                    a = b
                    b = nb
                    i2 -= 1
            else:
                let i2 = n - 1
                while i2 > 0:
                    di := f64(i2 + i2)
                    nb := b * di / x - a
                    a = b
                    b = nb
                    if b > 1e100:
                        a = a / b
                        t = t / b
                        b = 1.0
                    i2 -= 1
            b = t * j0(x) / b
    if sign:
        return -b
    b

## Bessel function of the second kind, order n.
pub fn yn(n0: i64, x: f64) -> f64:
    if x < 0.0 || is_nan(x):
        return nan()
    if is_inf(x, 1):
        return 0.0
    if n0 == 0:
        return y0(x)
    if x == 0.0:
        if n0 < 0 && n0 & 1 == 1:
            return inf(1)
        return inf(-1)
    let n = n0
    let sign = false
    if n < 0:
        n = -n
        if n & 1 == 1:
            sign = true
    if n == 1:
        if sign:
            return -y1(x)
        return y1(x)
    let b = 0.0
    if x >= TWO302:
        let (s, c) = sincos(x)
        let temp = 0.0
        nm := n & 3
        if nm == 0:
            temp = s - c
        else if nm == 1:
            temp = -s - c
        else if nm == 2:
            temp = -s + c
        else:
            temp = s + c
        b = INV_SQRTPI * temp / x.sqrt()
    else:
        let a = y0(x)
        b = y1(x)
        let i = 1i64
        while i < n && !is_inf(b, -1):
            t := fma(f64(i + i) / x, b, -a)
            a = b
            b = t
            i += 1
    if sign:
        return -b
    b
