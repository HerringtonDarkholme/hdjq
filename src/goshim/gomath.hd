fn erf_small_ratio(x: f64) -> f64:
    z := x * x
    r := fma(z, fma(z, fma(z, fma(z, PP[4], PP[3]), PP[2]), PP[1]), PP[0])
    s := fma(z, fma(z, fma(z, fma(z, fma(z, QQ[5], QQ[4]), QQ[3]), QQ[2]), QQ[1]), 1.0)
    r / s

fn erf_mid(x: f64) -> (f64, f64):
    s := x - 1.0
    p := fma(
        s,
        fma(s, fma(s, fma(s, fma(s, fma(s, PA[6], PA[5]), PA[4]), PA[3]), PA[2]), PA[1]),
        PA[0],
    )
    q := fma(
        s,
        fma(s, fma(s, fma(s, fma(s, fma(s, QA[6], QA[5]), QA[4]), QA[3]), QA[2]), QA[1]),
        1.0,
    )
    (p, q)

fn erf_tail_a(s: f64) -> f64:
    r := fma(
        s,
        fma(
            s,
            fma(s, fma(s, fma(s, fma(s, fma(s, RA[7], RA[6]), RA[5]), RA[4]), RA[3]), RA[2]),
            RA[1],
        ),
        RA[0],
    )
    ss := fma(
        s,
        fma(
            s,
            fma(
                s,
                fma(s, fma(s, fma(s, fma(s, fma(s, SA[8], SA[7]), SA[6]), SA[5]), SA[4]), SA[3]),
                SA[2],
            ),
            SA[1],
        ),
        1.0,
    )
    r / ss

fn erf_tail_b(s: f64) -> f64:
    r := fma(
        s,
        fma(s, fma(s, fma(s, fma(s, fma(s, RB[6], RB[5]), RB[4]), RB[3]), RB[2]), RB[1]),
        RB[0],
    )
    ss := fma(
        s,
        fma(
            s,
            fma(s, fma(s, fma(s, fma(s, fma(s, SB[7], SB[6]), SB[5]), SB[4]), SB[3]), SB[2]),
            SB[1],
        ),
        1.0,
    )
    r / ss

## exp(-x*x - 0.5625 + R/S) as Go computes it, split at a pseudo-single z.
fn erf_exp(x: f64, rs: f64) -> f64:
    z := f64::from_bits(x.to_bits() & u64(0xffffffff00000000))
    exp(fma(-z, z, -0.5625)) * exp(fma(z - x, z + x, rs))

## The error function.
pub fn erf(x0: f64) -> f64:
    very_tiny := 2.848094538889218e-306
    if is_nan(x0):
        return nan()
    if is_inf(x0, 1):
        return 1.0
    if is_inf(x0, -1):
        return -1.0
    let x = x0
    let sign = false
    if x < 0.0:
        x = -x
        sign = true
    if x < 0.84375:
        let temp = 0.0
        if x < TWOM28:
            if x < very_tiny:
                temp = 0.125 * fma(EFX8, x, 8.0 * x)
            else:
                temp = fma(EFX, x, x)
        else:
            temp = fma(x, erf_small_ratio(x), x)
        if sign:
            return -temp
        return temp
    if x < 1.25:
        let (p, q) = erf_mid(x)
        if sign:
            return -ERX - p / q
        return ERX + p / q
    if x >= 6.0:
        if sign:
            return -1.0
        return 1.0
    s := 1.0 / (x * x)
    rs := if x < f64::from_bits(u64(0x4006db6db6db6db7)): erf_tail_a(s) else: erf_tail_b(s)
    r := erf_exp(x, rs)
    if sign:
        return r / x - 1.0
    1.0 - r / x

## The complementary error function, 1 - erf(x).
pub fn erfc(x0: f64) -> f64:
    if is_nan(x0):
        return nan()
    if is_inf(x0, 1):
        return 0.0
    if is_inf(x0, -1):
        return 2.0
    let x = x0
    let sign = false
    if x < 0.0:
        x = -x
        sign = true
    if x < 0.84375:
        let temp = 0.0
        if x < TWOM56:
            temp = x
        else:
            y := erf_small_ratio(x)
            if x < 0.25:
                temp = fma(x, y, x)
            else:
                temp = 0.5 + fma(x, y, x - 0.5)
        if sign:
            return 1.0 + temp
        return 1.0 - temp
    if x < 1.25:
        let (p, q) = erf_mid(x)
        if sign:
            return f64::from_bits(u64(0x3ffd8560b0000000)) + p / q
        return f64::from_bits(u64(0x3fc3d4fa80000000)) - p / q
    if x < 28.0:
        s := 1.0 / (x * x)
        let rs = 0.0
        if x < f64::from_bits(u64(0x4006db6db6db6db7)):
            rs = erf_tail_a(s)
        else:
            if sign && x > 6.0:
                return 2.0
            rs = erf_tail_b(s)
        r := erf_exp(x, rs)
        if sign:
            return 2.0 - r / x
        return r / x
    if sign:
        return 2.0
    0.0

