]

fn sin_pi(x0: f64) -> f64:
    if x0 < 0.25:
        return -sin(PI * x0)
    let x = x0
    let z = x.floor()
    let n = 0i64
    if z != x:
        x = mod(x, 2.0)
        n = i64(x * 4.0)
    else:
        if x >= TWO53:
            x = 0.0
            n = 0
        else:
            if x < TWO52:
                z = x + TWO52
            n = i64(1 & z.to_bits())
            x = f64(n)
            n = n << 2
    if n == 0:
        x = sin(PI * x)
    else if n == 1 || n == 2:
        x = cos(PI * (0.5 - x))
    else if n == 3 || n == 4:
        x = sin(PI * (1.0 - x))
    else if n == 5 || n == 6:
        x = -cos(PI * (x - 1.5))
    else:
        x = sin(PI * (x - 2.0))
    -x

## The natural logarithm of |Gamma(x)| and the sign of Gamma(x), as Go's `math.Lgamma`.
pub fn lgamma(x0: f64) -> (f64, i64):
    tc := 1.46163214496836224576e+00
    tf := -1.21486290535849611461e-01
    tt := -3.63867699703950536541e-18
    let sign = 1i64
    if is_nan(x0):
        return (x0, sign)
    if is_inf(x0, 0):
        return (x0, sign)
    if x0 == 0.0:
        return (inf(1), sign)
    let x = x0
    let neg = false
    if x < 0.0:
        x = -x
        neg = true
    if x < TWOM70:
        if neg:
            sign = -1
        return (-log(x), sign)
    let nadj = 0.0
    if neg:
        if x >= TWO52:
            return (inf(1), sign)
        t := sin_pi(x)
        if t == 0.0:
            return (inf(1), sign)
        nadj = log(PI / (t * x).abs())
        if t < 0.0:
            sign = -1
    let lg = 0.0
    if x == 1.0 || x == 2.0:
        return (0.0, sign)
    else if x < 2.0:
        let y = 0.0
        let i = 0i64
        if x <= 0.9:
            lg = -log(x)
            if x >= f64::from_bits(u64(0x3fe76987d0eaed22)):
                y = 1.0 - x
                i = 0
            else if x >= f64::from_bits(u64(0x3fc88766f1c02f69)):
                y = x - f64::from_bits(u64(0x3fdd8b618d5af8fc))
                i = 1
            else:
                y = x
                i = 2
        else:
            lg = 0.0
            if x >= f64::from_bits(u64(0x3ffbb4c3e8757691)):
                y = 2.0 - x
                i = 0
            else if x >= f64::from_bits(u64(0x3ff310ecde3805ed)):
                y = x - tc
                i = 1
            else:
                y = x - 1.0
                i = 2
        if i == 0:
            z := y * y
            p1 := fma(
                z,
                fma(
                    z,
                    fma(z, fma(z, fma(z, LGAM_A[10], LGAM_A[8]), LGAM_A[6]), LGAM_A[4]),
                    LGAM_A[2],
                ),
                LGAM_A[0],
            )
            p2in := fma(
                z,
                fma(
                    z,
                    fma(z, fma(z, fma(z, LGAM_A[11], LGAM_A[9]), LGAM_A[7]), LGAM_A[5]),
                    LGAM_A[3],
                ),
                LGAM_A[1],
            )
            p := fma(z, p2in, y * p1)
            lg = lg + fma(-0.5, y, p)
        else if i == 1:
            z := y * y
            w := z * y
            p1 := fma(
                w,
                fma(w, fma(w, fma(w, LGAM_T[12], LGAM_T[9]), LGAM_T[6]), LGAM_T[3]),
                LGAM_T[0],
            )
            p2 := fma(
                w,
                fma(w, fma(w, fma(w, LGAM_T[13], LGAM_T[10]), LGAM_T[7]), LGAM_T[4]),
                LGAM_T[1],
            )
            p3 := fma(
                w,
                fma(w, fma(w, fma(w, LGAM_T[14], LGAM_T[11]), LGAM_T[8]), LGAM_T[5]),
                LGAM_T[2],
            )
            p := fma(z, p1, -fma(-w, fma(y, p3, p2), tt))
            lg = lg + (tf + p)
        else:
            p1 := (
                y
                * fma(
                    y,
                    fma(
                        y,
                        fma(y, fma(y, fma(y, LGAM_U[5], LGAM_U[4]), LGAM_U[3]), LGAM_U[2]),
                        LGAM_U[1],
                    ),
                    LGAM_U[0],
                )
            )
            p2 := fma(
                y,
                fma(
                    y,
                    fma(y, fma(y, fma(y, LGAM_V[5], LGAM_V[4]), LGAM_V[3]), LGAM_V[2]),
                    LGAM_V[1],
                ),
                1.0,
            )
            lg = lg + fma(-0.5, y, p1 / p2)
    else if x < 8.0:
        i := i64(x)
        y := x - f64(i)
        p := (
            y
            * fma(
                y,
                fma(
                    y,
                    fma(
                        y,
                        fma(y, fma(y, fma(y, LGAM_S[6], LGAM_S[5]), LGAM_S[4]), LGAM_S[3]),
                        LGAM_S[2],
                    ),
                    LGAM_S[1],
                ),
                LGAM_S[0],
            )
        )
        q := fma(
            y,
            fma(
                y,
                fma(
                    y,
                    fma(y, fma(y, fma(y, LGAM_R[6], LGAM_R[5]), LGAM_R[4]), LGAM_R[3]),
                    LGAM_R[2],
                ),
                LGAM_R[1],
            ),
            1.0,
        )
        lg = fma(0.5, y, p / q)
        let z = 1.0
        if i >= 7:
            z = z * (y + 6.0)
        if i >= 6:
            z = z * (y + 5.0)
        if i >= 5:
            z = z * (y + 4.0)
        if i >= 4:
            z = z * (y + 3.0)
        if i >= 3:
            z = z * (y + 2.0)
            lg = lg + log(z)
    else if x < TWO58:
        t := log(x)
        z := 1.0 / x
        y := z * z
        w := fma(
            z,
            fma(
                y,
                fma(
                    y,
                    fma(y, fma(y, fma(y, LGAM_W[6], LGAM_W[5]), LGAM_W[4]), LGAM_W[3]),
                    LGAM_W[2],
                ),
                LGAM_W[1],
            ),
            LGAM_W[0],
        )
        lg = fma(x - 0.5, t - 1.0, w)
    else:
        lg = x * (log(x) - 1.0)
    if neg:
        lg = nadj - lg
    (lg, sign)

