## A port of the pure-Go implementations in Go's `math` package.
##
## The goal is results bit-identical to a native Go program on darwin/arm64.
## Two arm64 details matter for that:
## - The Go compiler fuses `a*b + c` and `a*b - c` into single-rounding
##   FMADD/FMSUB instructions. Every place where Go fuses is written here as
##   an explicit `fma` call, checked against the compiled Go code.
## - `Exp` and `Exp2` are arm64 assembly (exp_arm64.s), so `exp` and `exp2`
##   port that assembly rather than exp.go.

# ---------------------------------------------------------------------------
# Bits and special values

UVNAN := u64(0x7FF8000000000001)
UVINF := u64(0x7FF0000000000000)
UVNEGINF := u64(0xFFF0000000000000)
SIGN_MASK := u64(0x8000000000000000)
FRAC_MASK := u64(0x000FFFFFFFFFFFFF)
EXP_MASK := u64(0x7FF)
BIAS := 1023i64

# Values of Go constant expressions, rounded the way the Go compiler rounds them.
FOUR_OVER_PI := f64::from_bits(u64(0x3ff45f306dc9c883))
PI := f64::from_bits(u64(0x400921fb54442d18))
PI4 := f64::from_bits(u64(0x3fe921fb54442d18))
PI2 := f64::from_bits(u64(0x3ff921fb54442d18))
PI3_4 := f64::from_bits(u64(0x4002d97c7f3321d2))
INV_SQRTPI := f64::from_bits(u64(0x3fe20dd750429b6d))
TWO_OVER_PI := f64::from_bits(u64(0x3fe45f306dc9c883))
NEG_TWO_OVER_PI := f64::from_bits(u64(0xbfe45f306dc9c883))
INV_LN10 := f64::from_bits(u64(0x3fdbcb7b1526e50e))
INV_LN2 := f64::from_bits(u64(0x3ff71547652b82fe))
LN2 := f64::from_bits(u64(0x3fe62e42fefa39ef))
SQRT2_2 := f64::from_bits(u64(0x3fe6a09e667f3bcd))
MAX_FLOAT64 := f64::from_bits(u64(0x7fefffffffffffff))
HALF_MAX_FLOAT64 := f64::from_bits(u64(0x7fdfffffffffffff))
SMALLEST_NORMAL := f64::from_bits(u64(0x0010000000000000))
TWO52 := f64::from_bits(u64(0x4330000000000000))
TWO53 := f64::from_bits(u64(0x4340000000000000))
TWO54 := f64::from_bits(u64(0x4350000000000000))
TWO58 := f64::from_bits(u64(0x4390000000000000))
TWO63 := f64::from_bits(u64(0x43e0000000000000))
TWO129 := f64::from_bits(u64(0x4800000000000000))
TWO302 := f64::from_bits(u64(0x52d0000000000000))
TWOM13 := f64::from_bits(u64(0x3f20000000000000))
TWOM27 := f64::from_bits(u64(0x3e40000000000000))
TWOM28 := f64::from_bits(u64(0x3e30000000000000))
TWOM29 := f64::from_bits(u64(0x3e20000000000000))
TWOM52 := f64::from_bits(u64(0x3cb0000000000000))
TWOM53 := f64::from_bits(u64(0x3ca0000000000000))
TWOM54 := f64::from_bits(u64(0x3c90000000000000))
TWOM56 := f64::from_bits(u64(0x3c70000000000000))
TWOM70 := f64::from_bits(u64(0x3b90000000000000))
TWO28 := f64::from_bits(u64(0x41b0000000000000))
REDUCE_THRESHOLD := f64::from_bits(u64(0x41c0000000000000))

fn nan() -> f64:
    f64::from_bits(UVNAN)

fn inf(sign: i64) -> f64:
    if sign >= 0: f64::from_bits(UVINF) else: f64::from_bits(UVNEGINF)

fn is_nan(x: f64) -> bool:
    x != x

## Go's `IsInf(f, sign)`: sign 0 matches either infinity.
fn is_inf(x: f64, sign: i64) -> bool:
    if sign == 0:
        return x.abs() > MAX_FLOAT64
    if sign < 0:
        return -x > MAX_FLOAT64
    x > MAX_FLOAT64

fn signbit(x: f64) -> bool:
    x.to_bits() >> 63 == 1

fn copysign(f: f64, sign: f64) -> f64:
    f64::from_bits((f.to_bits() & ~SIGN_MASK) | (sign.to_bits() & SIGN_MASK))

fn normalize(x: f64) -> (f64, i64):
    if x.abs() < SMALLEST_NORMAL:
        return (x * TWO52, -52i64)
    (x, 0i64)

# Shifts with Go semantics: a count of 64 or more gives 0.
fn shl(x: u64, n: u64) -> u64:
    if n >= 64: 0 else: x << u32(n)

fn shr(x: u64, n: u64) -> u64:
    if n >= 64: 0 else: x >> u32(n)

## The low `n` bits set, as Go's `1<<n - 1` on uint64.
fn low_mask(n: u64) -> u64:
    shl(1, n).wrapping_sub(1)

# ---------------------------------------------------------------------------
# math/bits helpers

fn mul64(x: u64, y: u64) -> (u64, u64):
    mask32 := u64(0xFFFFFFFF)
    x0 := x & mask32
    x1 := x >> 32
    y0 := y & mask32
    y1 := y >> 32
    w0 := x0 * y0
    t := x1 * y0 + (w0 >> 32)
    w1 := (t & mask32) + x0 * y1
    w2 := t >> 32
    hi := x1 * y1 + w2 + (w1 >> 32)
    (hi, x.wrapping_mul(y))

fn add64(x: u64, y: u64, carry: u64) -> (u64, u64):
    sum := x.wrapping_add(y).wrapping_add(carry)
    (sum, ((x & y) | ((x | y) & ~sum)) >> 63)

fn sub64(x: u64, y: u64, borrow: u64) -> (u64, u64):
    diff := x.wrapping_sub(y).wrapping_sub(borrow)
    (diff, ((~x & y) | (~(x ^ y) & diff)) >> 63)

fn leading_zeros64(x: u64) -> i64:
    i64(x.leading_zeros())

# ---------------------------------------------------------------------------
# FMA (fma.go)

fn zero_flag(x: u64) -> u64:
    if x == 0: 1 else: 0

fn nonzero_flag(x: u64) -> u64:
    if x != 0: 1 else: 0

fn shl128(u1: u64, u2: u64, n: u64) -> (u64, u64):
    r1 := shl(u1, n) | shr(u2, u64(64).wrapping_sub(n)) | shl(u2, n.wrapping_sub(64))
    (r1, shl(u2, n))

fn shr128(u1: u64, u2: u64, n: u64) -> (u64, u64):
    r2 := shr(u2, n) | shl(u1, u64(64).wrapping_sub(n)) | shr(u1, n.wrapping_sub(64))
    (shr(u1, n), r2)

fn shrcompress(u1: u64, u2: u64, n: u64) -> (u64, u64):
    if n == 0:
        return (u1, u2)
    if n == 64:
        return (0, u1 | nonzero_flag(u2))
    if n >= 128:
        return (0, nonzero_flag(u1 | u2))
    let (r1, r2) = shr128(u1, u2, n)
    if n < 64:
        return (r1, r2 | nonzero_flag(u2 & low_mask(n)))
    (r1, r2 | nonzero_flag((u1 & low_mask(n - 64)) | u2))

fn lz128(u1: u64, u2: u64) -> i64:
    let l = leading_zeros64(u1)
    if l == 64:
        l += leading_zeros64(u2)
    l

fn split(b: u64) -> (u64, i64, u64):
    sign := b >> 63
    let exp = i64((b >> 52) & EXP_MASK)
    let mantissa = b & FRAC_MASK
    if exp == 0:
        sh := u64(leading_zeros64(mantissa) - 11)
        mantissa = mantissa << u32(sh)
        exp = 1 - i64(sh)
    else:
        mantissa = mantissa | (u64(1) << 52)
    (sign, exp, mantissa)

## x*y + z computed with only one rounding (Go's `math.FMA`).
pub fn fma(x: f64, y: f64, z: f64) -> f64:
    bx := x.to_bits()
    by := y.to_bits()
    bz := z.to_bits()
    if x == 0.0 || y == 0.0 || bx & UVINF == UVINF || by & UVINF == UVINF:
        return x * y + z
    if z == 0.0:
        return x * y
    if bz & UVINF == UVINF:
        return z
    let (xs, xe, xm) = split(bx)
    let (ys, ye, ym) = split(by)
    let (zs0, ze0, zm) = split(bz)
    let pe = xe + ye - BIAS + 1
    let (pm1, pm2) = mul64(xm << 10, ym << 11)
    let zm1 = zm << 10
    let zm2: u64 = 0
    let ps = xs ^ ys
    let zs = zs0
    let ze = ze0
    is62zero := (~pm1 >> 62) & 1
    let (a1, a2) = shl128(pm1, pm2, is62zero)
    pm1 = a1
    pm2 = a2
    pe -= i64(is62zero)
    if pe < ze || (pe == ze && pm1 < zm1):
        t_s := ps
        t_e := pe
        t_m1 := pm1
        t_m2 := pm2
        ps = zs
        pe = ze
        pm1 = zm1
        pm2 = zm2
        zs = t_s
        ze = t_e
        zm1 = t_m1
        zm2 = t_m2
    if ps != zs && pe == ze && pm1 == zm1 && pm2 == zm2:
        return 0.0
    let (c1, c2) = shrcompress(zm1, zm2, u64(pe - ze))
    zm1 = c1
    zm2 = c2
    let m: u64 = 0
    if ps == zs:
        let (s2, carry) = add64(pm2, zm2, 0)
        let (s1, _) = add64(pm1, zm1, carry)
        pe -= i64(~s1 >> 63)
        let (r1, r2) = shrcompress(s1, s2, 64 + (s1 >> 63))
        pm1 = r1
        m = r2
        pm2 = s2
    else:
        let (d2, borrow) = sub64(pm2, zm2, 0)
        let (d1, _) = sub64(pm1, zm1, borrow)
        nz := lz128(d1, d2)
        pe -= nz
        let (r1, r2) = shl128(d1, d2, u64(nz - 1))
        m = r1 | nonzero_flag(r2)
    if pe > 1022 + BIAS || (pe == 1022 + BIAS && (m.wrapping_add(u64(1) << 9)) >> 63 == 1):
        return f64::from_bits((ps << 63) | UVINF)
    if pe < 0:
        n := u64(-pe)
        m = shr(m, n) | nonzero_flag(m & low_mask(n))
        pe = 0
    m = (m.wrapping_add(u64(1) << 9) >> 10) & ~zero_flag((m & 1023) ^ (u64(1) << 9))
    if nonzero_flag(m) == 0:
        pe = 0
    f64::from_bits((ps << 63).wrapping_add(u64(pe) << 52).wrapping_add(m))

# ---------------------------------------------------------------------------
# Frexp, Ldexp, Modf, Mod, Remainder, Nextafter, Hypot, Logb, Ilogb

## Splits `f` into a fraction in [0.5, 1) and a power of two.
pub fn frexp(f: f64) -> (f64, i64):
    if f == 0.0:
        return (f, 0i64)
    if is_inf(f, 0) || is_nan(f):
        return (f, 0i64)
    let (g, e0) = normalize(f)
    let x = g.to_bits()
    exp := e0 + i64((x >> 52) & EXP_MASK) - BIAS + 1
    x = x & ~(EXP_MASK << 52)
    x = x | (u64(BIAS - 1) << 52)
    (f64::from_bits(x), exp)

## frac × 2**e.
pub fn ldexp(frac0: f64, e: i64) -> f64:
    if frac0 == 0.0:
        return frac0
    if is_inf(frac0, 0) || is_nan(frac0):
        return frac0
    let (frac, e0) = normalize(frac0)
    let exp = e.wrapping_add(e0)
    let x = frac.to_bits()
    exp = exp.wrapping_add(i64(x >> 52) & i64(EXP_MASK)).wrapping_sub(BIAS)
    if exp < -1075:
        return copysign(0.0, frac)
    if exp > 1023:
        if frac < 0.0:
            return inf(-1)
        return inf(1)
    let m = 1.0
    if exp < -1022:
        exp += 53
        m = TWOM53
    x = x & ~(EXP_MASK << 52)
    x = x | (u64(exp + BIAS) << 52)
    m * f64::from_bits(x)

## Integer and fractional parts with the sign of `f`, like Go's `math.Modf`.
pub fn modf(f: f64) -> (f64, f64):
    integer := f.trunc()
    (integer, copysign(f - integer, f))

## The floating-point remainder of x/y, with the sign of x.
pub fn mod(x: f64, y0: f64) -> f64:
    if y0 == 0.0 || is_inf(x, 0) || is_nan(x) || is_nan(y0):
        return nan()
    y := y0.abs()
    let (yfr, yexp) = frexp(y)
    let r = x
    if x < 0.0:
        r = -x
    while r >= y:
        let (rfr, rexp0) = frexp(r)
        let rexp = rexp0
        if rfr < yfr:
            rexp = rexp - 1
        r = r - ldexp(y, rexp - yexp)
    if x < 0.0:
        r = -r
    r

## The IEEE 754 remainder of x/y.
pub fn remainder(x0: f64, y0: f64) -> f64:
    tiny := f64::from_bits(u64(0x0020000000000000))
    if is_nan(x0) || is_nan(y0) || is_inf(x0, 0) || y0 == 0.0:
        return nan()
    if is_inf(y0, 0):
        return x0
    let x = x0
    let y = y0
    let sign = false
    if x < 0.0:
        x = -x
        sign = true
    if y < 0.0:
        y = -y
    if x == y:
        if sign:
            return -0.0
        return 0.0
    if y <= HALF_MAX_FLOAT64:
        x = mod(x, y + y)
    if y < tiny:
        if x + x > y:
            x -= y
            if x + x >= y:
                x -= y
    else:
        y_half := 0.5 * y
        if x > y_half:
            x -= y
            if x >= y_half:
                x -= y
    if sign:
        x = -x
    x

## The next representable value after x towards y.
pub fn nextafter(x: f64, y: f64) -> f64:
    if is_nan(x) || is_nan(y):
        return nan()
    if x == y:
        return x
    if x == 0.0:
        return copysign(f64::from_bits(1), y)
    if (y > x) == (x > 0.0):
        return f64::from_bits(x.to_bits() + 1)
    f64::from_bits(x.to_bits() - 1)

## sqrt(p*p + q*q), avoiding needless overflow.
pub fn hypot(p0: f64, q0: f64) -> f64:
    let p = p0.abs()
    let q = q0.abs()
    if is_inf(p, 1) || is_inf(q, 1):
        return inf(1)
    if is_nan(p) || is_nan(q):
        return nan()
    if p < q:
        t := p
        p = q
        q = t
    if p == 0.0:
        return 0.0
    q = q / p
    p * fma(q, q, 1.0).sqrt()

fn ilogb_raw(x0: f64) -> i64:
    let (x, exp) = normalize(x0)
    i64((x.to_bits() >> 52) & EXP_MASK) - BIAS + exp

## The binary exponent of x.
pub fn logb(x: f64) -> f64:
    if x == 0.0:
        return inf(-1)
    if is_inf(x, 0):
        return inf(1)
    if is_nan(x):
        return x
    f64(ilogb_raw(x))

## The binary exponent of x as an integer; Go's MinInt32 for 0, MaxInt32 for Inf and NaN.
pub fn ilogb(x: f64) -> i64:
    if x == 0.0:
        return -2147483648i64
    if is_nan(x):
        return 2147483647i64
    if is_inf(x, 0):
        return 2147483647i64
    ilogb_raw(x)

# ---------------------------------------------------------------------------
# Trigonometry (sin.go, tan.go, sincos.go, trig_reduce.go)

SIN_C := [
    1.58962301576546568060e-10,
    -2.50507477628578072866e-8,
    2.75573136213857245213e-6,
    -1.98412698295895385996e-4,
    8.33333333332211858878e-3,
    -1.66666666666666307295e-1,
]
COS_C := [
    -1.13585365213876817300e-11,
    2.08757008419747316778e-9,
    -2.75573141792967388112e-7,
    2.48015872888517045348e-5,
    -1.38888888888730564116e-3,
    4.16666666666665929218e-2,
]
PI4A := 7.85398125648498535156e-1
PI4B := 3.77489470793079817668e-8
PI4C := 2.69515142907905952645e-15

M_PI4 := [
    u64(0x0000000000000001),
    u64(0x45f306dc9c882a53),
    u64(0xf84eafa3ea69bb81),
    u64(0xb6c52b3278872083),
    u64(0xfca2c757bd778ac3),
    u64(0x6e48dc74849ba5c0),
    u64(0x0c925dd413a32439),
    u64(0xfc3bd63962534e7d),
    u64(0xd1046bea5d768909),
    u64(0xd338e04d68befc82),
    u64(0x7323ac7306a673e9),
    u64(0x3908bf177bf25076),
    u64(0x3ff12fffbc0b301f),
    u64(0xde5e2316b414da3e),
    u64(0xda6cfd9e4f96136e),
    u64(0x9e8c7ecd3cbfd45a),
    u64(0xea4f758fd7cbe2f6),
    u64(0x7a0e73ef14a525d4),
    u64(0xd7f6bf623f1aba10),
    u64(0xac06608df8f6d757),
]

## Payne-Hanek reduction for x >= REDUCE_THRESHOLD: the octant and the reduced angle.
fn trig_reduce(x: f64) -> (u64, f64):
    if x < PI4:
        return (0, x)
    let ix = x.to_bits()
    exp := i64((ix >> 52) & EXP_MASK) - BIAS - 52
    ix = ix & ~(EXP_MASK << 52)
    ix = ix | (u64(1) << 52)
    digit := usize(u64(exp + 61) / 64)
    bitshift := u64(exp + 61) % 64
    z0 := shl(M_PI4[digit], bitshift) | shr(M_PI4[digit + 1], 64 - bitshift)
    z1 := shl(M_PI4[digit + 1], bitshift) | shr(M_PI4[digit + 2], 64 - bitshift)
    z2 := shl(M_PI4[digit + 2], bitshift) | shr(M_PI4[digit + 3], 64 - bitshift)
    let (z2hi, _) = mul64(z2, ix)
    let (z1hi, z1lo) = mul64(z1, ix)
    z0lo := z0.wrapping_mul(ix)
    let (lo, c) = add64(z1lo, z2hi, 0)
    let (hi, _) = add64(z0lo, z1hi, c)
    let j = hi >> 61
    hi = (hi << 3) | (lo >> 61)
    lz := u64(leading_zeros64(hi))
    e := u64(1023) - (lz + 1)
    hi = shl(hi, lz + 1) | shr(lo, u64(64).wrapping_sub(lz + 1))
    hi = hi >> 12
    hi = hi | (e << 52)
    let z = f64::from_bits(hi)
    if j & 1 == 1:
        j += 1
        j = j & 7
        z = z - 1.0
    (j, z * PI4)

## Octant j and reduced argument z for |x| (x already non-negative).
fn trig_octant(x: f64) -> (u64, f64):
    if x >= REDUCE_THRESHOLD:
        return trig_reduce(x)
    let j = u64(x * FOUR_OVER_PI)
    let y = f64(j)
    if j & 1 == 1:
        j += 1
        y += 1.0
    j = j & 7
    (j, fma(-y, PI4C, fma(-y, PI4B, fma(-y, PI4A, x))))

## The (j, z) reduction used by tan: no `j &= 7`.
fn tan_octant(x: f64) -> (u64, f64):
    if x >= REDUCE_THRESHOLD:
        return trig_reduce(x)
    let j = u64(x * FOUR_OVER_PI)
    let y = f64(j)
    if j & 1 == 1:
        j += 1
        y += 1.0
    (j, fma(-y, PI4C, fma(-y, PI4B, fma(-y, PI4A, x))))

fn sin_kernel(z: f64, zz: f64) -> f64:
    p := fma(
        fma(fma(fma(fma(SIN_C[0], zz, SIN_C[1]), zz, SIN_C[2]), zz, SIN_C[3]), zz, SIN_C[4]),
        zz,
        SIN_C[5],
    )
    fma(z * zz, p, z)

fn cos_kernel(zz: f64) -> f64:
    p := fma(
        fma(fma(fma(fma(COS_C[0], zz, COS_C[1]), zz, COS_C[2]), zz, COS_C[3]), zz, COS_C[4]),
        zz,
        COS_C[5],
    )
    fma(zz * zz, p, fma(-0.5, zz, 1.0))

## Cosine of x radians.
pub fn cos(x0: f64) -> f64:
    if is_nan(x0) || is_inf(x0, 0):
        return nan()
    let sign = false
    x := x0.abs()
    let (j0, z) = trig_octant(x)
    let j = j0
    if j > 3:
        j -= 4
        sign = !sign
    if j > 1:
        sign = !sign
    zz := z * z
    let y = if j == 1 || j == 2: sin_kernel(z, zz) else: cos_kernel(zz)
    if sign:
        y = -y
    y

## Sine of x radians.
pub fn sin(x0: f64) -> f64:
    if x0 == 0.0 || is_nan(x0):
        return x0
    if is_inf(x0, 0):
        return nan()
    let x = x0
    let sign = false
    if x < 0.0:
        x = -x
        sign = true
    let (j0, z) = trig_octant(x)
    let j = j0
    if j > 3:
        sign = !sign
        j -= 4
    zz := z * z
    let y = if j == 1 || j == 2: cos_kernel(zz) else: sin_kernel(z, zz)
    if sign:
        y = -y
    y

## Sine and cosine together (Go's `math.Sincos`).
fn sincos(x0: f64) -> (f64, f64):
    if x0 == 0.0:
        return (x0, 1.0)
    if is_nan(x0) || is_inf(x0, 0):
        return (nan(), nan())
    let x = x0
    let sin_sign = false
    let cos_sign = false
    if x < 0.0:
        x = -x
        sin_sign = true
    let (j0, z) = trig_octant(x)
    let j = j0
    if j > 3:
        j -= 4
        sin_sign = !sin_sign
        cos_sign = !cos_sign
    if j > 1:
        cos_sign = !cos_sign
    zz := z * z
    let c = cos_kernel(zz)
    let s = sin_kernel(z, zz)
    if j == 1 || j == 2:
        t := s
        s = c
        c = t
    if cos_sign:
        c = -c
    if sin_sign:
        s = -s
    (s, c)

TAN_P := [-1.30936939181383777646e4, 1.15351664838587416140e6, -1.79565251976484877988e7]
TAN_Q := [
    1.00000000000000000000e0,
    1.36812963470692954678e4,
    -1.32089234440210967447e6,
    2.50083801823357915839e7,
    -5.38695755929454629881e7,
]

## Tangent of x radians.
pub fn tan(x0: f64) -> f64:
    if x0 == 0.0 || is_nan(x0):
        return x0
    if is_inf(x0, 0):
        return nan()
    let x = x0
    let sign = false
    if x < 0.0:
        x = -x
        sign = true
    let (j, z) = tan_octant(x)
    zz := z * z
    let y = z
    if zz > 1e-14:
        num := zz * fma(fma(TAN_P[0], zz, TAN_P[1]), zz, TAN_P[2])
        den := fma(fma(fma(fma(z, z, TAN_Q[1]), zz, TAN_Q[2]), zz, TAN_Q[3]), zz, TAN_Q[4])
        y = fma(z, num / den, z)
    if j & 2 == 2:
        y = -1.0 / y
    if sign:
        y = -y
    y

# ---------------------------------------------------------------------------
# Inverse trigonometry (asin.go, atan.go, atan2.go)

fn xatan(x: f64) -> f64:
    p0 := -8.750608600031904122785e-01
    p1 := -1.615753718733365076637e+01
    p2 := -7.500855792314704667340e+01
    p3 := -1.228866684490136173410e+02
    p4 := -6.485021904942025371773e+01
    q0 := 2.485846490142306297962e+01
    q1 := 1.650270098316988542046e+02
    q2 := 4.328810604912902668951e+02
    q3 := 4.853903996359136964868e+02
    q4 := 1.945506571482613964425e+02
    z := x * x
    num := fma(fma(fma(fma(p0, z, p1), z, p2), z, p3), z, p4)
    den := fma(fma(fma(fma(fma(x, x, q0), z, q1), z, q2), z, q3), z, q4)
    w := z * num / den
    fma(x, w, x)

fn satan(x: f64) -> f64:
    morebits := 6.123233995736765886130e-17
    tan3pio8 := 2.41421356237309504880
    if x <= 0.66:
        return xatan(x)
    if x > tan3pio8:
        return PI2 - xatan(1.0 / x) + morebits
    PI4 + xatan((x - 1.0) / (x + 1.0)) + f64::from_bits(u64(0x3c81a62633145c07))

## Arcsine, in radians.
pub fn asin(x0: f64) -> f64:
    if x0 == 0.0:
        return x0
    let x = x0
    let sign = false
    if x < 0.0:
        x = -x
        sign = true
    if x > 1.0:
        return nan()
    let temp = fma(-x, x, 1.0).sqrt()
    if x > 0.7:
        temp = PI2 - satan(temp / x)
    else:
        temp = satan(x / temp)
    if sign:
        temp = -temp
    temp

## Arccosine, in radians.
pub fn acos(x: f64) -> f64:
    PI2 - asin(x)

## Arctangent, in radians.
pub fn atan(x: f64) -> f64:
    if x == 0.0:
        return x
    if x > 0.0:
        return satan(x)
    -satan(-x)

## Arctangent of y/x, using the signs of both to pick the quadrant.
pub fn atan2(y: f64, x: f64) -> f64:
    if is_nan(y) || is_nan(x):
        return nan()
    if y == 0.0:
        if x >= 0.0 && !signbit(x):
            return copysign(0.0, y)
        return copysign(PI, y)
    if x == 0.0:
        return copysign(PI2, y)
    if is_inf(x, 0):
        if is_inf(x, 1):
            if is_inf(y, 0):
                return copysign(PI4, y)
            return copysign(0.0, y)
        if is_inf(y, 0):
            return copysign(PI3_4, y)
        return copysign(PI, y)
    if is_inf(y, 0):
        return copysign(PI2, y)
    q := atan(y / x)
    if x < 0.0:
        if q <= 0.0:
            return q + PI
        return q - PI
    q

# ---------------------------------------------------------------------------
# Exponentials (exp_arm64.s, expm1.go)

EXP_LN2HI := 6.93147180369123816490e-01
EXP_LN2LO := 1.90821492927058770002e-10
EXP_LOG2E := 1.44269504088896338700e+00
EXP_P1 := 1.66666666666666657415e-01
EXP_P2 := -2.77777777770155933842e-03
EXP_P3 := 6.61375632143793436117e-05
EXP_P4 := -1.65339022054652515390e-06
EXP_P5 := 4.13813679705723846039e-08

## The tail shared by the arm64 Exp and Exp2: y = e**r scaled by 2**k,
## with Ldexp inlined the way the assembly does it.
fn exp_tail(hi: f64, lo: f64, k: i64) -> f64:
    r := hi - lo
    t := r * r
    poly := fma(fma(fma(fma(EXP_P5, t, EXP_P4), t, EXP_P3), t, EXP_P2), t, EXP_P1)
    c := fma(-poly, t, r)
    y := 1.0 - ((lo - (r * c) / (2.0 - c)) - hi)
    b := y.to_bits()
    frac := b & FRAC_MASK
    let e = i64(b >> 52).wrapping_add(k)
    let m = 1.0
    if e < 1:
        e = e + 52
        m = TWOM52
    f64::from_bits(frac | (u64(e) << 52)) * m

## e**x.
pub fn exp(x: f64) -> f64:
    if x != x:
        return x
    if x > 7.09782712893383973096e+02:
        return inf(1)
    if x < -7.45133219101941108420e+02:
        return 0.0
    if x.abs() < TWOM28:
        return 1.0 + x
    kf := if x < 0.0: fma(EXP_LOG2E, x, -0.5) else: fma(EXP_LOG2E, x, 0.5)
    k := i64(kf)
    fk := f64(k)
    hi := fma(-EXP_LN2HI, fk, x)
    lo := fk * EXP_LN2LO
    exp_tail(hi, lo, k)

## 2**x.
pub fn exp2(x: f64) -> f64:
    if x != x:
        return x
    if x > 1.0239999999999999e+03:
        return inf(1)
    if x < -1.0740e+03:
        return 0.0
    kf := if x < 0.0: x - 0.5 else: x + 0.5
    k := i64(kf)
    t := x - f64(k)
    hi := t * EXP_LN2HI
    lo := -(EXP_LN2LO * t)
    exp_tail(hi, lo, k)

## e**x - 1, accurate for x near zero.
pub fn expm1(x0: f64) -> f64:
    othreshold := 7.09782712893383973096e+02
    ln2x56 := 3.88162421113569373274e+01
    ln2halfx3 := 1.03972077083991796413e+00
    ln2half := 3.46573590279972654709e-01
    ln2hi := 6.93147180369123816490e-01
    ln2lo := 1.90821492927058770002e-10
    invln2 := 1.44269504088896338700e+00
    q1 := -3.33333333333331316428e-02
    q2 := 1.58730158725481460165e-03
    q3 := -7.93650757867487942473e-05
    q4 := 4.00821782732936239552e-06
    q5 := -2.01099218183624371326e-07
    if is_inf(x0, 1) || is_nan(x0):
        return x0
    if is_inf(x0, -1):
        return -1.0
    let x = x0
    let absx = x
    let sign = false
    if x < 0.0:
        absx = -absx
        sign = true
    if absx >= ln2x56:
        if sign:
            return -1.0
        if absx >= othreshold:
            return inf(1)
    let c = 0.0
    let k = 0i64
    if absx > ln2half:
        let hi = 0.0
        let lo = 0.0
        if absx < ln2halfx3:
            if !sign:
                hi = x - ln2hi
                lo = ln2lo
                k = 1
            else:
                hi = x + ln2hi
                lo = -ln2lo
                k = -1
        else:
            if !sign:
                k = i64(fma(invln2, x, 0.5))
            else:
                k = i64(fma(invln2, x, -0.5))
            t := f64(k)
            hi = fma(-t, ln2hi, x)
            lo = t * ln2lo
        x = hi - lo
        c = (hi - x) - lo
    else if absx < TWOM54:
        return x
    else:
        k = 0
    hfx := 0.5 * x
    hxs := x * hfx
    r1 := fma(hxs, fma(hxs, fma(hxs, fma(hxs, fma(hxs, q5, q4), q3), q2), q1), 1.0)
    t := fma(-r1, hfx, 3.0)
    qq := (r1 - t) / fma(-x, t, 6.0)
    let e = hxs * qq
    if k == 0:
        return x - fma(-x, hfx, x * e)
    e = fma(x, fma(hxs, qq, -c), -c)
    e = fma(-x, hfx, e)
    if k == -1:
        return fma(0.5, x - e, -0.5)
    if k == 1:
        if x < -0.25:
            return -2.0 * (e - (x + 0.5))
        return 1.0 + 2.0 * (x - e)
    if k <= -2 || k > 56:
        let y = 1.0 - (e - x)
        y = f64::from_bits(y.to_bits().wrapping_add(u64(k) << 52))
        return y - 1.0
    if k < 20:
        t2 := f64::from_bits(u64(0x3ff0000000000000) - (u64(0x20000000000000) >> u32(k)))
        let y = t2 - (e - x)
        y = f64::from_bits(y.to_bits().wrapping_add(u64(k) << 52))
        return y
    t3 := f64::from_bits(u64(0x3ff - k) << 52)
    let y = x - (e + t3)
    y = y + 1.0
    f64::from_bits(y.to_bits().wrapping_add(u64(k) << 52))

# ---------------------------------------------------------------------------
# Hyperbolic functions (sinh.go, tanh.go, asinh.go, acosh.go, atanh.go)

## Hyperbolic sine.
pub fn sinh(x0: f64) -> f64:
    p0 := -0.6307673640497716991184787251e+6
    p1 := -0.8991272022039509355398013511e+5
    p2 := -0.2894211355989563807284660366e+4
    p3 := -0.2630563213397497062819489e+2
    q0 := -0.6307673640497716991212077277e+6
    q1 := 0.1521517378790019070696485176e+5
    q2 := -0.173678953558233699533450911e+3
    let x = x0
    let sign = false
    if x < 0.0:
        x = -x
        sign = true
    let temp = 0.0
    if x > 21.0:
        temp = exp(x) * 0.5
    else if x > 0.5:
        ex := exp(x)
        temp = (ex - 1.0 / ex) * 0.5
    else:
        sq := x * x
        temp = fma(fma(fma(p3, sq, p2), sq, p1), sq, p0) * x
        temp = temp / fma(fma(fma(x, x, q2), sq, q1), sq, q0)
    if sign:
        temp = -temp
    temp

## Hyperbolic cosine.
pub fn cosh(x0: f64) -> f64:
    x := x0.abs()
    if x > 21.0:
        return exp(x) * 0.5
    ex := exp(x)
    (ex + 1.0 / ex) * 0.5

TANH_P := [-9.64399179425052238628e-1, -9.92877231001918586564e1, -1.61468768441708447952e3]
TANH_Q := [1.12811678491632931402e2, 2.23548839060100448583e3, 4.84406305325125486048e3]

## Hyperbolic tangent.
pub fn tanh(x: f64) -> f64:
    maxlog := 8.8029691931113054295988e+01
    let z = x.abs()
    if z > 0.5 * maxlog:
        if x < 0.0:
            return -1.0
        return 1.0
    if z >= 0.625:
        s := exp(z + z)
        z = 1.0 - 2.0 / (s + 1.0)
        if x < 0.0:
            z = -z
        return z
    if x == 0.0:
        return x
    s := x * x
    num := fma(fma(TANH_P[0], s, TANH_P[1]), s, TANH_P[2])
    den := fma(fma(fma(x, x, TANH_Q[0]), s, TANH_Q[1]), s, TANH_Q[2])
    x + x * s * num / den

## Inverse hyperbolic sine.
pub fn asinh(x0: f64) -> f64:
    ln2 := 6.93147180559945286227e-01
    if is_nan(x0) || is_inf(x0, 0):
        return x0
    let x = x0
    let sign = false
    if x < 0.0:
        x = -x
        sign = true
    let temp = 0.0
    if x > TWO28:
        temp = log(x) + ln2
    else if x > 2.0:
        temp = log((x + x) + 1.0 / (fma(x, x, 1.0).sqrt() + x))
    else if x < 1.0 / 268435456.0:
        temp = x
    else:
        temp = log1p(x + x * x / (1.0 + fma(x, x, 1.0).sqrt()))
    if sign:
        temp = -temp
    temp

## Inverse hyperbolic cosine.
pub fn acosh(x: f64) -> f64:
    if x < 1.0 || is_nan(x):
        return nan()
    if x == 1.0:
        return 0.0
    if x >= TWO28:
        return log(x) + LN2
    if x > 2.0:
        return log((x + x) - 1.0 / (x + fma(x, x, -1.0).sqrt()))
    t := x - 1.0
    log1p(t + fma(t, t, t + t).sqrt())

## Inverse hyperbolic tangent.
pub fn atanh(x0: f64) -> f64:
    if x0 < -1.0 || x0 > 1.0 || is_nan(x0):
        return nan()
    if x0 == 1.0:
        return inf(1)
    if x0 == -1.0:
        return inf(-1)
    let x = x0
    let sign = false
    if x < 0.0:
        x = -x
        sign = true
    let temp = 0.0
    if x < TWOM28:
        temp = x
    else if x < 0.5:
        temp = x + x
        temp = 0.5 * log1p(temp + temp * x / (1.0 - x))
    else:
        temp = 0.5 * log1p((x + x) / (1.0 - x))
    if sign:
        temp = -temp
    temp

# ---------------------------------------------------------------------------
# Logarithms (log.go, log10.go, log1p.go)

LG_LN2HI := 6.93147180369123816490e-01
LG_LN2LO := 1.90821492927058770002e-10
LG_L1 := 6.666666666666735130e-01
LG_L2 := 3.999999999940941908e-01
LG_L3 := 2.857142874366239149e-01
LG_L4 := 2.222219843214978396e-01
LG_L5 := 1.818357216161805012e-01
LG_L6 := 1.531383769920937332e-01
LG_L7 := 1.479819860511658591e-01

## Natural logarithm.
pub fn log(x: f64) -> f64:
    if is_nan(x) || is_inf(x, 1):
        return x
    if x < 0.0:
        return nan()
    if x == 0.0:
        return inf(-1)
    let (f1_, ki_) = frexp(x)
    let f1 = f1_
    let ki = ki_
    if f1 < SQRT2_2:
        f1 = f1 + f1
        ki -= 1
    f := f1 - 1.0
    k := f64(ki)
    s := f / (2.0 + f)
    s2 := s * s
    s4 := s2 * s2
    a := fma(s4, fma(s4, fma(s4, LG_L7, LG_L5), LG_L3), LG_L1)
    t2 := s4 * fma(s4, fma(s4, LG_L6, LG_L4), LG_L2)
    r := fma(s2, a, t2)
    hf := 0.5 * f
    inner := fma(s, fma(hf, f, r), k * LG_LN2LO)
    fma(k, LG_LN2HI, -(fma(hf, f, -inner) - f))

## Decimal logarithm.
pub fn log10(x: f64) -> f64:
    log(x) * INV_LN10

## Binary logarithm.
pub fn log2(x: f64) -> f64:
    let (frac, exp) = frexp(x)
    if frac == 0.5:
        return f64(exp - 1)
    fma(log(frac), INV_LN2, f64(exp))

## log(1 + x), accurate for x near zero.
pub fn log1p(x: f64) -> f64:
    sqrt2m1 := 4.142135623730950488017e-01
    sqrt2halfm1 := -2.928932188134524755992e-01
    lp1 := 6.666666666666735130e-01
    lp2 := 3.999999999940941908e-01
    lp3 := 2.857142874366239149e-01
    lp4 := 2.222219843214978396e-01
    lp5 := 1.818357216161805012e-01
    lp6 := 1.531383769920937332e-01
    lp7 := 1.479819860511658591e-01
    if x < -1.0 || is_nan(x):
        return nan()
    if x == -1.0:
        return inf(-1)
    if is_inf(x, 1):
        return inf(1)
    absx := x.abs()
    let f = 0.0
    let iu: u64 = 0
    let k = 1i64
    if absx < sqrt2m1:
        if absx < TWOM29:
            if absx < TWOM54:
                return x
            return fma(-(x * x), 0.5, x)
        if x > sqrt2halfm1:
            k = 0
            f = x
            iu = 1
    let c = 0.0
    if k != 0:
        let u = 0.0
        if absx < TWO53:
            u = 1.0 + x
            iu = u.to_bits()
            k = i64(iu >> 52) - 1023
            if k > 0:
                c = 1.0 - (u - x)
            else:
                c = x - (u - 1.0)
            c = c / u
        else:
            u = x
            iu = u.to_bits()
            k = i64(iu >> 52) - 1023
            c = 0.0
        iu = iu & u64(0x000fffffffffffff)
        if iu < u64(0x0006a09e667f3bcd):
            u = f64::from_bits(iu | u64(0x3ff0000000000000))
        else:
            k += 1
            u = f64::from_bits(iu | u64(0x3fe0000000000000))
            iu = (u64(0x0010000000000000) - iu) >> 2
        f = u - 1.0
    hf := 0.5 * f
    fk := f64(k)
    if iu == 0:
        if f == 0.0:
            if k == 0:
                return 0.0
            c = fma(fk, LG_LN2LO, c)
            return fma(fk, LG_LN2HI, c)
        hfsq := hf * f
        inner := fma(-0.66666666666666666, f, 1.0)
        if k == 0:
            return fma(-hfsq, inner, f)
        return fma(fk, LG_LN2HI, -(fma(hfsq, inner, -fma(fk, LG_LN2LO, c)) - f))
    s := f / (2.0 + f)
    z := s * s
    rr := z * fma(z, fma(z, fma(z, fma(z, fma(z, fma(z, lp7, lp6), lp5), lp4), lp3), lp2), lp1)
    a := fma(hf, f, rr)
    if k == 0:
        return f - fma(-s, a, hf * f)
    d := fma(s, a, fma(fk, LG_LN2LO, c))
    fma(fk, LG_LN2HI, -(fma(hf, f, -d) - f))

# ---------------------------------------------------------------------------
# Cube root and power (cbrt.go, pow.go)

## Cube root.
pub fn cbrt(x0: f64) -> f64:
    b1 := u64(715094163)
    b2 := u64(696219795)
    cc := 5.42857142857142815906e-01
    dd := -7.05306122448979611050e-01
    ee := 1.41428571428571436819e+00
    ff := 1.60714285714285720630e+00
    gg := 3.57142857142857150787e-01
    if x0 == 0.0 || is_nan(x0) || is_inf(x0, 0):
        return x0
    let x = x0
    let sign = false
    if x < 0.0:
        x = -x
        sign = true
    let t = f64::from_bits(x.to_bits() / 3 + (b1 << 32))
    if x < SMALLEST_NORMAL:
        t = TWO54
        t = t * x
        t = f64::from_bits(t.to_bits() / 3 + (b2 << 32))
    let r = t * t / x
    let s = fma(r, t, cc)
    t = t * (gg + ff / (s + ee + dd / s))
    t = f64::from_bits((t.to_bits() & (u64(0xFFFFFFFFC) << 28)) + (u64(1) << 30))
    s = t * t
    r = x / s
    w := t + t
    r = (r - t) / (w + r)
    t = fma(t, r, t)
    if sign:
        t = -t
    t

fn is_odd_int(x: f64) -> bool:
    if x.abs() >= TWO53:
        return false
    let (xi, xf) = modf(x)
    xf == 0.0 && i64(xi) & 1 == 1

## x**y.
pub fn pow(x: f64, y: f64) -> f64:
    if y == 0.0 || x == 1.0:
        return 1.0
    if y == 1.0:
        return x
    if is_nan(x) || is_nan(y):
        return nan()
    if x == 0.0:
        if y < 0.0:
            if signbit(x) && is_odd_int(y):
                return inf(-1)
            return inf(1)
        if y > 0.0:
            if signbit(x) && is_odd_int(y):
                return x
            return 0.0
    else if is_inf(y, 0):
        if x == -1.0:
            return 1.0
        if (x.abs() < 1.0) == is_inf(y, 1):
            return 0.0
        return inf(1)
    else if is_inf(x, 0):
        if is_inf(x, -1):
            return pow(1.0 / x, -y)
        if y < 0.0:
            return 0.0
        if y > 0.0:
            return inf(1)
    else if y == 0.5:
        return x.sqrt()
    else if y == -0.5:
        return 1.0 / x.sqrt()
    let (yi0, yf0) = modf(y.abs())
    let yi = yi0
    let yf = yf0
    if yf != 0.0 && x < 0.0:
        return nan()
    if yi >= TWO63:
        if x == -1.0:
            return 1.0
        if (x.abs() < 1.0) == (y > 0.0):
            return 0.0
        return inf(1)
    let a1 = 1.0
    let ae = 0i64
    if yf != 0.0:
        if yf > 0.5:
            yf = yf - 1.0
            yi = yi + 1.0
        a1 = exp(yf * log(x))
    let (x1_, xe_) = frexp(x)
    let x1 = x1_
    let xe = xe_
    let i = i64(yi)
    while i != 0:
        if xe < -4096 || 4096 < xe:
            ae += xe
            break
        if i & 1 == 1:
            a1 = a1 * x1
            ae += xe
        x1 = x1 * x1
        xe = xe * 2
        if x1 < 0.5:
            x1 = x1 + x1
            xe -= 1
        i = i >> 1
    if y < 0.0:
        a1 = 1.0 / a1
        ae = -ae
    ldexp(a1, ae)

# ---------------------------------------------------------------------------
# Gamma (gamma.go, lgamma.go)

GAM_P := [
    1.60119522476751861407e-04,
    1.19135147006586384913e-03,
    1.04213797561761569935e-02,
    4.76367800457137231464e-02,
    2.07448227648435975150e-01,
    4.94214826801497100753e-01,
    9.99999999999999996796e-01,
]
GAM_Q := [
    -2.31581873324120129819e-05,
    5.39605580493303397842e-04,
    -4.45641913851797240494e-03,
    1.18139785222060435552e-02,
    3.58236398605498653373e-02,
    -2.34591795718243348568e-01,
    7.14304917030273074085e-02,
    1.00000000000000000320e+00,
]
GAM_S := [
    7.87311395793093628397e-04,
    -2.29549961613378126380e-04,
    -2.68132617805781232825e-03,
    3.47222221605458667310e-03,
    8.33333333333482257126e-02,
]

fn stirling(x: f64) -> (f64, f64):
    if x > 200.0:
        return (inf(1), 1.0)
    sqrt_two_pi := 2.506628274631000502417
    max_stirling := 143.01608
    let w = 1.0 / x
    w = fma(
        w,
        fma(fma(fma(fma(GAM_S[0], w, GAM_S[1]), w, GAM_S[2]), w, GAM_S[3]), w, GAM_S[4]),
        1.0,
    )
    let y1 = exp(x)
    let y2 = 1.0
    if x > max_stirling:
        v := pow(x, fma(0.5, x, -0.25))
        y2 = v / y1
        y1 = v
    else:
        y1 = pow(x, x - 0.5) / y1
    (y1, sqrt_two_pi * w * y2)

fn is_neg_int(x: f64) -> bool:
    if x < 0.0:
        let (_, xf) = modf(x)
        return xf == 0.0
    false

## The Gamma function.
pub fn gamma(x0: f64) -> f64:
    euler := 0.57721566490153286060651209008240243104215933593992
    if is_neg_int(x0) || is_inf(x0, -1) || is_nan(x0):
        return nan()
    if is_inf(x0, 1):
        return inf(1)
    if x0 == 0.0:
        if signbit(x0):
            return inf(-1)
        return inf(1)
    let x = x0
    let q = x.abs()
    let p = q.floor()
    if q > 33.0:
        if x >= 0.0:
            let (y1, y2) = stirling(x)
            return y1 * y2
        let signgam = 1i64
        ip := i64(p)
        if ip & 1 == 0:
            signgam = -1
        let z = q - p
        if z > 0.5:
            p = p + 1.0
            z = q - p
        z = q * sin(PI * z)
        if z == 0.0:
            return inf(signgam)
        let (sq1, sq2) = stirling(q)
        absz := z.abs()
        d := absz * sq1 * sq2
        if is_inf(d, 0):
            z = PI / absz / sq1 / sq2
        else:
            z = PI / d
        return f64(signgam) * z
    let z = 1.0
    while x >= 3.0:
        x = x - 1.0
        z = z * x
    let small = false
    while x < 0.0:
        if x > -1e-09:
            small = true
            break
        z = z / x
        x = x + 1.0
    if !small:
        while x < 2.0:
            if x < 1e-09:
                small = true
                break
            z = z / x
            x = x + 1.0
    if small:
        if x == 0.0:
            return inf(1)
        return z / (fma(euler, x, 1.0) * x)
    if x == 2.0:
        return z
    x = x - 2.0
    p = fma(
        fma(
            fma(fma(fma(fma(x, GAM_P[0], GAM_P[1]), x, GAM_P[2]), x, GAM_P[3]), x, GAM_P[4]),
            x,
            GAM_P[5],
        ),
        x,
        GAM_P[6],
    )
    q = fma(
        fma(
            fma(
                fma(fma(fma(fma(x, GAM_Q[0], GAM_Q[1]), x, GAM_Q[2]), x, GAM_Q[3]), x, GAM_Q[4]),
                x,
                GAM_Q[5],
            ),
            x,
            GAM_Q[6],
        ),
        x,
        GAM_Q[7],
    )
    z * p / q

