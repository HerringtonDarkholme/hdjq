## Port of gojq/cli/inputs.go (without the YAML input). An io.Reader is a
## Reader here: stdin or a file, read whole when the iterator first needs it
## (hd reads stdin and files whole). Errors become gojq errors carrying the
## text gojq prints, since `input` hands them to the query.
use std.console.{ConsoleInput, read_all}
use std.fs.{FsRead, read_bytes}
use std.path.Path
use pkg.goshim.value.{Value, arr}
use pkg.goshim.json.{Decoder, new_decoder_bytes, JsonErr}
use pkg.goshim.encoding.lossy
use pkg.gojq.iter.{Item, InputIter}
use pkg.gojq.error.JqError
use pkg.gojq.module_loader.fs_error_string
use pkg.cli.error.{CliError, JsonErrKind, cli_error_string}
use pkg.cli.stream.{JsonStream, StreamNext, new_json_stream}

## An input source: stdin (path `.None`) or a file.
pub struct Reader:
    path: string?
    data: (List[u8])? = .None
    consumed: bool = false

impl Reader:
    ## Reads the rest of the input: all of it the first time, as an
    ## io.Reader read to its end, and nothing afterwards.
    pub fn read_bytes!(&mut self) -> Result[List[u8], string] $ ConsoleInput + FsRead:
        if self.consumed:
            return .Ok([])
        self.consumed = true
        match self.data:
            .Some(b) => return .Ok(b)
            .None => pass
        match self.path:
            .None =>
                # os.Stdin as bytes: read_all! rewrites \r\n (hd-lang #2398)
                match read_bytes!(Path("/dev/stdin")):
                    .Ok(b) => .Ok(b)
                    .Err(_) =>
                        match read_all!():
                            .Ok(s) => .Ok(s.bytes().collect())
                            .Err(_) => .Ok([])
            .Some(p) =>
                match read_bytes!(Path(p)):
                    .Ok(b) => .Ok(b)
                    .Err(e) => .Err(fs_error_string("read", p, e))

    ## The rest of the input as a Go string.
    pub fn read!(&mut self) -> Result[string, string] $ ConsoleInput + FsRead:
        match self.read_bytes!():
            .Ok(b) => .Ok(lossy(b))
            .Err(e) => .Err(e)

pub fn stdin_reader() -> *mut Reader:
    box(Reader { path: .None })

## inputIter: gojq.Iter, io.Closer and Name.
pub trait CliIter:
    fn next!(&mut self) -> Item? $ ConsoleInput + FsRead
    fn close(&mut self) -> void
    fn name(&self) -> string

fn count_newline_bytes(s: List[u8], from: i64, to: i64) -> i64:
    let n = 0i64
    let i = from
    while i < to && i < i64(s.len()):
        if s[usize(i)] == 0x0a:
            n += 1
        i += 1
    n

fn err_item(e: CliError) -> Item:
    .Err(.Message(cli_error_string(e)))

## Which reader-based iterator a filesInputIter makes for each file.
pub enum IterKind:
    Json
    Stream
    Raw
    ReadAll

pub fn new_iter(kind: IterKind, r: *mut Reader, fname: string) -> *mut dyn CliIter:
    match kind:
        .Json => new_json_input_iter(r, fname, false)
        .Stream => new_json_input_iter(r, fname, true)
        .Raw => box(RawInputIter { r: r, fname: fname })
        .ReadAll => box(ReadAllIter { r: r, fname: fname })

# ---------------------------------------------------------------- jsonInputIter

pub struct JsonInputIter:
    r: *mut Reader
    dec: (*mut Decoder)? = .None
    stream: (*mut JsonStream)? = .None
    is_stream: bool
    contents: List[u8] = []
    fname: string
    done: bool = false
    ## the start of Go's tee buffer of stdin (jsonInputIter.offset), and the
    ## lines before it
    offset: i64 = 0
    line: i64 = 0

pub fn new_json_input_iter(r: *mut Reader, fname: string, is_stream: bool) -> *mut JsonInputIter:
    box(JsonInputIter { r: r, fname: fname, is_stream: is_stream })

fn json_kind(e: JsonErr) -> JsonErrKind:
    match e:
        .Syntax(msg, off) => .Syntax(msg, off)
        .UnexpectedEOF => .UnexpectedEOF

impl JsonInputIter:
    pub fn decoder!(&mut self) -> Result[*mut Decoder, string] $ ConsoleInput + FsRead:
        match self.dec:
            .Some(d) => return .Ok(d)
            .None => pass
        t := self.r.read_bytes!()?
        self.contents = t
        d := new_decoder_bytes(t)
        self.dec = .Some(d)
        if self.is_stream:
            self.stream = .Some(new_json_stream(d))
        .Ok(d)

    fn fail(&mut self, e: JsonErr) -> Item:
        self.done = true
        let .Some(dec) = self.dec else: return .Err(.Message("json"))
        text := self.contents
        let kind = json_kind(e)
        match self.r.path:
            .None =>
                # inputReader over a pipe: the contents are what was read
                contents := text.slice(usize(self.offset), usize(dec.read_end()))
                match kind:
                    .Syntax(msg, off) => kind = .Syntax(msg, off - self.offset)
                    _ => pass
                err_item(.JsonParse(self.fname, contents, self.line, kind))
            .Some(_) =>
                # inputReader.getContents over a seekable file
                let offset = match kind:
                    .Syntax(_, off) => off
                    _ => i64(text.len())
                let line = 0i64
                let start = 0i64
                while offset > 16 * 1024 * 3 / 4:
                    let n = 16 * 1024i64
                    if offset - 4096 < n:
                        n = offset - 4096
                    if start + n > i64(text.len()):
                        n = i64(text.len()) - start
                    offset -= n
                    line += count_newline_bytes(text, start, start + n)
                    start += n
                    if n == 0:
                        break
                let end = start + 16 * 1024
                if end > i64(text.len()):
                    end = i64(text.len())
                match kind:
                    .Syntax(msg, _) => kind = .Syntax(msg, offset)
                    _ => pass
                err_item(.JsonParse(self.fname, text.slice(usize(start), usize(end)), line, kind))

    ## After a value, Go drops the consumed part of its 16KiB tee buffer.
    fn advance(&mut self, dec: *mut Decoder) -> void:
        if self.r.path.is_none() && dec.read_end() - self.offset >= 16 * 1024:
            consumed := dec.input_offset() - self.offset
            self.line += count_newline_bytes(self.contents, self.offset, self.offset + consumed)
            self.offset += consumed

impl CliIter for JsonInputIter:
    fn next!(&mut self) -> Item? $ ConsoleInput + FsRead:
        if self.done:
            return .None
        let dec = match self.decoder!():
            .Ok(d) => d
            .Err(msg) =>
                self.done = true
                return .Some(.Err(.Message(msg)))
        match self.stream:
            .Some(s) =>
                match s.next():
                    .V(v) =>
                        self.advance(dec)
                        return .Some(.V(v))
                    .Eof =>
                        self.done = true
                        return .None
                    .Err(e) => return .Some(self.fail(e))
            .None => pass
        match dec.decode():
            .Ok(.Some(v)) =>
                self.advance(dec)
                .Some(.V(v))
            .Ok(.None) =>
                self.done = true
                .None
            .Err(e) => .Some(self.fail(e))

    fn close(&mut self) -> void:
        self.done = true

    fn name(&self) -> string:
        self.fname

# ---------------------------------------------------------------- nullInputIter

pub struct NullInputIter:
    done: bool = false

pub fn new_null_input_iter() -> *mut NullInputIter:
    box(NullInputIter {})

impl CliIter for NullInputIter:
    fn next!(&mut self) -> Item? $ ConsoleInput + FsRead:
        if self.done:
            return .None
        self.done = true
        .Some(.V(.Null))

    fn close(&mut self) -> void:
        self.done = true

    fn name(&self) -> string:
        ""

# ---------------------------------------------------------------- filesInputIter

pub struct FilesInputIter:
    kind: IterKind
    fnames: List[string]
    stdin: (*mut Reader)?
    iter: (*mut dyn CliIter)? = .None
    file: (*mut Reader)? = .None
    done: bool = false

pub fn new_files_input_iter(kind: IterKind, fnames: List[string], stdin: (*mut Reader)?) -> *mut FilesInputIter:
    box(FilesInputIter { kind: kind, fnames: fnames, stdin: stdin })

impl CliIter for FilesInputIter:
    fn next!(&mut self) -> Item? $ ConsoleInput + FsRead:
        if self.done:
            return .None
        while true:
            if self.file.is_none():
                if self.fnames.is_empty():
                    self.done = true
                    match self.iter:
                        .Some(it) => it.close()
                        .None => pass
                    self.iter = .None
                    return .None
                let fname = self.fnames[0]
                self.fnames = self.fnames.slice(1, self.fnames.len())
                let file: (*mut Reader)? = .None
                match self.stdin:
                    .Some(s) =>
                        if fname == "-":
                            file = .Some(s)
                            fname = "<stdin>"
                    .None => pass
                if file.is_none():
                    # os.Open: report a missing file before reading it
                    match read_bytes!(Path(fname)):
                        .Ok(b) => file = .Some(box(Reader { path: .Some(fname), data: .Some(b) }))
                        .Err(.IsADirectory(_)) => file = .Some(box(Reader { path: .Some(fname) }))
                        .Err(e) => return .Some(.Err(.Message(fs_error_string("open", fname, e))))
                self.file = file
                match self.iter:
                    .Some(it) => it.close()
                    .None => pass
                match file:
                    .Some(f) => self.iter = .Some(new_iter(self.kind, f, fname))
                    .None => pass
            match self.iter:
                .Some(it) =>
                    match it.next!():
                        .Some(v) => return .Some(v)
                        .None => pass
                .None => pass
            self.file = .None
        .None

    fn close(&mut self) -> void:
        if self.file.is_some():
            self.file = .None
            self.done = true

    fn name(&self) -> string:
        match self.iter:
            .Some(it) => it.name()
            .None => ""

# ---------------------------------------------------------------- rawInputIter

pub struct RawInputIter:
    r: *mut Reader
    fname: string
    text: string? = .None
    pos: usize = 0
    done: bool = false

impl CliIter for RawInputIter:
    fn next!(&mut self) -> Item? $ ConsoleInput + FsRead:
        if self.done:
            return .None
        let text = match self.text:
            .Some(t) => t
            .None =>
                match self.r.read!():
                    .Ok(t) =>
                        self.text = .Some(t)
                        t
                    .Err(msg) =>
                        self.done = true
                        return .Some(.Err(.Message(msg)))
        rest := text.slice(self.pos, text.len())
        match rest.find("\n"):
            .Some(i) =>
                self.pos += i + 1
                .Some(.V(.Str(rest.slice(0, i))))
            .None =>
                self.done = true
                self.pos = text.len()
                if rest == "":
                    return .None
                .Some(.V(.Str(rest)))

    fn close(&mut self) -> void:
        self.done = true

    fn name(&self) -> string:
        self.fname

# ---------------------------------------------------------------- slurpInputIter

pub struct SlurpInputIter:
    iter: (*mut dyn CliIter)?
    done: bool = false

impl CliIter for SlurpInputIter:
    fn next!(&mut self) -> Item? $ ConsoleInput + FsRead:
        if self.done:
            return .None
        let .Some(it) = self.iter else: return .None
        let mut vs: List[Value] = []
        while true:
            match it.next!():
                .None =>
                    self.done = true
                    return .Some(.V(arr(vs)))
                .Some(.Err(e)) =>
                    self.done = true
                    return .Some(.Err(e))
                .Some(.V(v)) => vs.push(v)
                .Some(_) => pass
        .None

    fn close(&mut self) -> void:
        match self.iter:
            .Some(it) =>
                it.close()
                self.iter = .None
                self.done = true
            .None => pass

    fn name(&self) -> string:
        match self.iter:
            .Some(it) => it.name()
            .None => ""

pub fn new_slurp_input_iter(iter: *mut dyn CliIter) -> *mut SlurpInputIter:
    box(SlurpInputIter { iter: .Some(iter) })

# ---------------------------------------------------------------- readAllIter

pub struct ReadAllIter:
    r: *mut Reader
    fname: string
    done: bool = false

impl CliIter for ReadAllIter:
    fn next!(&mut self) -> Item? $ ConsoleInput + FsRead:
        if self.done:
            return .None
        self.done = true
        match self.r.read!():
            .Ok(t) => .Some(.V(.Str(t)))
            .Err(msg) => .Some(.Err(.Message(msg)))

    fn close(&mut self) -> void:
        self.done = true

    fn name(&self) -> string:
        self.fname

# ---------------------------------------------------------------- slurpRawInputIter

pub struct SlurpRawInputIter:
    iter: (*mut dyn CliIter)?
    done: bool = false

impl CliIter for SlurpRawInputIter:
    fn next!(&mut self) -> Item? $ ConsoleInput + FsRead:
        if self.done:
            return .None
        let .Some(it) = self.iter else: return .None
        let mut vs: List[string] = []
        while true:
            match it.next!():
                .None =>
                    self.done = true
                    return .Some(.V(.Str(vs.join(""))))
                .Some(.Err(e)) =>
                    self.done = true
                    return .Some(.Err(e))
                .Some(.V(.Str(s))) => vs.push(s)
                .Some(_) => pass
        .None

    fn close(&mut self) -> void:
        match self.iter:
            .Some(it) =>
                it.close()
                self.iter = .None
                self.done = true
            .None => pass

    fn name(&self) -> string:
        match self.iter:
            .Some(it) => it.name()
            .None => ""

pub fn new_slurp_raw_input_iter(iter: *mut dyn CliIter) -> *mut SlurpRawInputIter:
    box(SlurpRawInputIter { iter: .Some(iter) })

# ---------------------------------------------------------------- gojq.WithInputIter

## Hands a CLI iterator to the compiler as its input iterator.
pub struct InputAdapter:
    pub it: *mut dyn CliIter

impl InputIter for InputAdapter:
    fn next!(&mut self) -> Item? $ ConsoleInput + FsRead:
        self.it.next!()
